# Build context for the relay + bundle images is the repo root
# (see docker-compose.yml). Without these excludes the daemon receives
# ~2GB of context per build, even for a fully-cached layer hit.

# Workspace dependency trees: the Dockerfiles run their own pnpm install.
node_modules
**/node_modules

# Build outputs: Dockerfiles rebuild from source.
dist
**/dist
.turbo
**/.turbo
# Coverage OUTPUT sits at a package root. Never **/coverage: the sdk's
# src/api/coverage and the app's src/coverage are source.
coverage
packages/*/coverage
mod/*/coverage
mod/*/client/coverage

# Git + editor + OS noise.
.git
.gitignore
.github
.vscode
.idea
.claude
**/.DS_Store

# Logs and local env.
*.log
**/*.log
.env
.env.*
!.env.example

# Tests aren't needed at image build time. Fixtures are: uplink-tools'
# build reads every widget's __fixtures__ to write its widget manifest.
**/*.test.ts
**/*.test.tsx
**/__tests__

# Docs the images don't need. scripts/ stays in the context: package builds
# call root scripts (prune-dist.mjs, gen-version.mjs and others), and the
# whole folder is under 1 MB. We deliberately leave other packages' sources
# in the context so pnpm's frozen-lockfile workspace resolution stays
# consistent: the heavy parts (node_modules, dist) are already excluded above.
local_docs
