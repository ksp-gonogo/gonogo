#!/bin/sh
# Pre-push gate: fast, affected-only checks. CI is the gate of record.
#
# That last sentence was false for the shrink-only ratchets until 2026-08-25:
# their base revision was unreachable on a runner, so all five returned early and
# reported green there, and this "deliberately LIGHT" hook was the only place they
# could fail. CI now fetches full history and resolves a real base per trigger
# (scripts/resolve-ratchet-base-ref.sh), so the sentence holds again.
#
# A push to main deploys the dev channel, and the deploy only fires when CI is
# green (deploy.yml triggers on a successful CI workflow_run). So a push that
# fails CI silently skips the deploy. This hook catches the common failures
# locally, but it is deliberately LIGHT: the full cross-package suite and the
# full cross-browser e2e matrix run in CI on dedicated runners, not here.
#
# What runs locally:
#   - biome (format + lint)
#   - `turbo run test test:scans`, cached + affected-only. NOT --force.
#     core's cross-package ratchets live in `test:scans`, which alone keys its
#     cache on the whole repo, so they re-run on any change while core's other
#     ~107 test files cache on core's own sources. Keying the WHOLE core suite
#     that way re-ran 134 files (85.7s) on every push whatever was touched, and
#     grew a 17 GB turbo cache doing it. CI=true makes vitest treat snapshots as
#     read-only (a mismatch fails instead of being silently rewritten).
#   - Playwright e2e ONLY for changed specs, chromium only. The full matrix
#     (chromium/firefox/webkit) + visual gate run in CI.
#
# Skip e2e for a quick push:  SKIP_E2E=1 git push   (CI still runs the matrix)
# Bypass the whole hook:      git push --no-verify
echo "pre-push: lint + affected test gate (CI runs the full matrix)..."

# Output is captured and only shown on FAILURE. A successful run of this hook
# printed 5178 lines, so everyone piped it to `tail` to read the verdict, and a
# pipe replaces the push's own exit status with the pipe's. Four separate silent
# non-pushes came from that on 2026-08-28 alone: the hook reported "all checks
# passed", the command exited 0, and nothing reached the remote. Quiet on
# success is what removes the reason to pipe.
GONOGO_HOOK_LOG="$(mktemp -t gonogo-prepush)"
trap 'rm -f "$GONOGO_HOOK_LOG"' EXIT

if ! pnpm exec biome check . > "$GONOGO_HOOK_LOG" 2>&1; then
  cat "$GONOGO_HOOK_LOG"
  echo "✖ pre-push: biome found issues, run 'pnpm lint' to auto-fix, then re-push."
  exit 1
fi
echo "pre-push: lint clean."

# --concurrency=1 keeps the run reliable on a loaded machine: several jsdom
# suites starting at once each spawn a worker pool, oversubscribe the CPU, and
# trip vitest's per-test timeout even though each is green run alone. With
# caching (no --force) only the affected packages run, so serial is still fast.
# `test:scans` is core's cross-package ratchet family, split from `test` so it
# alone carries a cache key over the whole repo. Both run here: the split is
# about CACHING, not coverage, and dropping the scans locally would put the
# em-dash / raw-hex / boundary guards back to CI-only.
# `pnpm push` (scripts/safe-push.mjs) runs this same gate BEFORE opening the
# connection, because git opens its socket before the hook runs and GitHub closes
# it if the hook outlives the idle timeout: git then dies with SIGPIPE while this
# script prints "all checks passed". When the gate has already run, skip it here
# rather than hold the socket open for a second full pass.
if [ "${GONOGO_GATE_DONE:-}" = "1" ]; then
  echo "pre-push: gate already run by pnpm push, not repeating it."
elif ! CI=true pnpm exec turbo run test test:scans --concurrency=1 > "$GONOGO_HOOK_LOG" 2>&1; then
  cat "$GONOGO_HOOK_LOG"
  echo "✖ pre-push: tests failed (this is what CI would have caught)."
  exit 1
fi
echo "pre-push: tests green ($(grep -cE "^ *Tasks:" "$GONOGO_HOOK_LOG" >/dev/null 2>&1 && grep -E "^ *Tasks:" "$GONOGO_HOOK_LOG" | tail -1 | tr -s " " || echo "turbo run complete"))."

# E2E: only the specs affected by this push, on chromium. CI runs the full
# cross-browser matrix as the gate of record. Playwright's --only-changed
# traces test-file imports; these specs drive a running server rather than
# importing app source, so an app-source-only change selects nothing here and
# relies on CI, which is the intended split. The git-diff gate avoids paying
# Playwright's webServer startup when no e2e file changed at all.
if [ "$SKIP_E2E" = "1" ]; then
  echo "pre-push: SKIP_E2E=1 set, skipping Playwright e2e (CI will still run it)."
else
  # Base = the branch's MERGE TARGET, which is `staging` for everything except a
  # direct push to main. It was `origin/main` unconditionally, from when branches
  # targeted main: staging is now ~1100 commits ahead of it with 33 spec files
  # different, so every push from every branch selected all 33 and the gate that
  # calls itself "deliberately LIGHT" had degenerated into a near-full run for
  # everybody. That is also a contention source: concurrent runs share one set of
  # webServers (`reuseExistingServer: !CI`), so whichever finishes first tears
  # them down under the other, and the loser fails with connection errors on
  # specs it never touched.
  if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
    BASE="origin/main"
  else
    BASE="origin/staging"
  fi
  # Diff against the MERGE BASE, not the tip: a branch that is merely BEHIND its
  # target would otherwise count the target's own spec changes as its own.
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
    echo "pre-push: no base ref ($BASE) to diff e2e against, skipping e2e (CI runs the full matrix)."
  else
    BASE="$(git merge-base HEAD "$BASE" 2>/dev/null || git rev-parse "$BASE")"
  fi
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
    : # already reported above
  elif git diff --quiet "$BASE" HEAD -- tests/playwright; then
    echo "pre-push: no e2e spec changes vs $BASE, skipping e2e (CI runs the full matrix)."
  else
    echo "pre-push: e2e specs changed vs $BASE, running affected specs on chromium..."
    if ! pnpm exec playwright test --only-changed="$BASE" --project=chromium --pass-with-no-tests; then
      echo "✖ pre-push: affected Playwright e2e failed (full matrix still runs in CI)."
      echo "  If browsers are missing: pnpm exec playwright install --with-deps chromium"
      echo "  Skip e2e for a quick push: SKIP_E2E=1 git push   (CI still gates it)."
      exit 1
    fi
  fi
fi

echo "pre-push: all checks passed."
