#!/bin/bash
# Refuse a fold that says nothing about what changed.
#
# staging's history is heading toward release notes generated per release, so
# every commit on it has to stand alone as a changelog line. A fold of a feature
# branch is not exempt: `git merge --squash` then ONE commit describing the
# CHANGE is the model, and `git merge` without --squash takes git's default
# subject, which names the branch and says nothing.
#
# 100 of those accumulated on staging before anyone counted, 25 of them in a
# single day. The branch name and the fact that it was a fold are noise.
#
# A merge of a REMOTE tracking branch is a different thing (syncing after a bot
# push) and is allowed through: this only refuses local topic branches.
set -euo pipefail

subject=$(head -1 "$1")

case "$subject" in
  "Merge branch 'fleet/"*|"Merge branch 'worktree-"*|"Merge branch 'agent-"*)
    cat >&2 <<MSG
commit-msg: refusing a fold that describes the fold instead of the change.

  $subject

staging history becomes release notes, so this needs to read as a changelog
line for the feature. Use:

  git merge --squash <branch>
  git commit          # subject: what CHANGED, imperative, no branch name

If you genuinely want a merge commit here, write its subject by hand.
MSG
    exit 1
    ;;
esac

# Refuse a body and a tracker reference
#
# THE STYLE, IN FULL. Duplicated here on purpose rather than linked: a hook that
# points at a document is a hook whose rule nobody reads at the moment it fires.
#
# INTENT: staging's history becomes release notes, generated per release. Every
# commit on it therefore has to stand alone as ONE CHANGELOG LINE, read by
# someone who was not here, has no memory of the session that produced it, and
# wants to know what changed. That single purpose is what every rule below comes
# from.
#
#   1. The SUBJECT carries the change. Imperative, specific, and about what
#      changed rather than what was done to the repository. `feat(x):`/`fix(x):`
#      prefixes are fine and are what the release tooling reads.
#      The subject is at most 100 characters: one line a reader can take in at
#      a glance. Past that it is carrying detail that is not the change.
#   2. NO BODY. A commit is a subject only. If the change does not fit a
#      100-character subject, the subject is carrying too much: keep the change
#      in the subject and put the rest on the ticket.
#   3. NO HISTORY-TELLING. Why the repo was in an odd state, what was tried
#      first, which agent did what, how long it took, what the measurement was:
#      all noise in a changelog. Cut it.
#   4. NO THIRD-PERSON NARRATION. Commits are authored as the repo author.
#      Never "the user", "the operator", "as requested", "user-flagged".
#   5. NO AI ATTRIBUTION of any kind, including a Co-Authored-By trailer.
#   6. NO TRACKER REFERENCE anywhere in the message. The repo is public and the
#      tracker is not: "Saga", "(Saga 911)", "batch 2", "stage 5.2",
#      "decision 220" and a bare "#123" mean nothing to a reader of the history.
#   7. A FOLD DESCRIBES THE FEATURE, never the fold. `git merge --squash`, then
#      one commit that reads like the changelog entry for what landed.
#
# Long, verbose, working-scaffolding commits are fine on a FEATURE BRANCH; they
# are discarded at the squash-fold. This hook guards what reaches staging.
#
# The length cap is not applied to a subject git is carrying over unchanged:
# `git commit --amend` that keeps the subject, and `git cherry-pick --continue`
# after a conflict, both run this hook with a message written before the cap, and
# the same carry-over exempts a body that is identical to the one already there.
# `git rebase` (reword included) does not run commit-msg at all.
#
# Footers are exempt (BREAKING CHANGE:, Refs:, Fixes:) because the release
# tooling reads them. A Refs: or Fixes: footer must name a public GitHub issue
# or pull request (#123) or a URL, since a name that only the tracker resolves is
# a tracker reference. A "#" is refused everywhere else. A git-generated revert
# body is exempt for the same reason it exists, and so is a body git carries
# over unchanged (see below).

# A co-author trailer is refused whoever it names. It arrives as a well-formed
# trailer, so the body rule below counts it as an exempt footer and lets it
# through; that was found by testing the hook rather than by reading it.
#
# Not an anti-assistant rule, though an assistant trailer is banned outright and
# must never be written: attribution of any kind is not a changelog line. Who
# wrote a change belongs in the commit's author field, which git already has.
if sed -e '/^#/d' "$1" | grep -qiE '^(co-authored-by|generated-with|assisted-by):'; then
  cat >&2 <<'MSG'
commit-msg: refusing an attribution trailer.

Attribution is not a changelog line, and git already records who authored the
commit. End the message at the subject.
MSG
  exit 1
fi

body=$(sed -e '/^#/d' "$1" | tail -n +2)

# A message git is carrying over (amend, cherry-pick --continue) keeps the body
# it already had; only an unchanged one is exempt.
carried_subject=0
carried_body=0
for rev in HEAD CHERRY_PICK_HEAD; do
  if existing=$(git log -1 --format=%s "$rev" 2>/dev/null) && [ "$existing" = "$subject" ]; then
    carried_subject=1
    existing_body=$(git log -1 --format=%b "$rev" 2>/dev/null || true)
    if [ "$(printf '%s' "$body" | sed -e '/^[[:space:]]*$/d')" = "$(printf '%s' "$existing_body" | sed -e '/^[[:space:]]*$/d')" ]; then
      carried_body=1
    fi
  fi
done

is_revert=0
case "$subject" in
  "Revert "*) is_revert=1 ;;
esac

# Footers the release tooling reads, and the body git writes for a revert.
prose=$(printf '%s\n' "$body" | grep -vE '^[[:space:]]*$' | grep -vE '^(BREAKING CHANGE|Refs|Fixes): ' || true)
if [ "$is_revert" -eq 1 ]; then
  prose=$(printf '%s\n' "$prose" | grep -vE '^This reverts commit [0-9a-f]+' || true)
fi
prose_lines=$(printf '%s' "$prose" | grep -c . || true)
[ "$carried_body" -eq 1 ] && prose_lines=0

# A Refs: or Fixes: footer resolves to a public GitHub issue or pull request, or
# a URL. Anything else names a ticket only the tracker can open.
bad_footer=$(printf '%s\n' "$body" | grep -E '^(Refs|Fixes): ' | grep -vE '^(Refs|Fixes): ((#[0-9]+|https?://[^[:space:]]+)(, ?|[[:space:]]+|$))+$' || true)

# Scan the subject and the footers; the reverted subject git quotes is not ours.
scan=$(sed -e '/^#/d' "$1")
if [ "$is_revert" -eq 1 ]; then
  scan=$(printf '%s\n' "$scan" | tail -n +2 | grep -vE '^This reverts commit ' || true)
else
  scan=$(printf '%s\n' "$scan" | grep -vE '^(Refs|Fixes): ((#[0-9]+|https?://[^[:space:]]+)(, ?|[[:space:]]+|$))+$' || true)
fi
if [ -n "$bad_footer" ] || printf '%s\n' "$scan" | grep -qiE '\bsaga\b|\bbatch [0-9]+|\bstage [0-9]+|\bdecision [0-9]+|#[0-9]+'; then
  cat >&2 <<MSG
commit-msg: refusing a reference to a tracker ticket.

  $subject

The repo is public and the tracker is not. A commit never names a ticket: not
"Saga", "(Saga 911)", "batch 2", "stage 5.2", "decision 220" or a bare "#123",
and a Refs: or Fixes: footer may only name a public GitHub issue or pull request
(#123) or a URL. Keep the change in the subject and put the rest on the ticket.
MSG
  exit 1
fi

if [ "${prose_lines:-0}" -gt 0 ]; then
  cat >&2 <<MSG
commit-msg: refusing a commit body.

staging history becomes release notes, so a commit is a subject only: ONE
CHANGELOG LINE for someone who was not here.

  $subject

Keep the change in the subject and put the rest on the ticket. Footers
(BREAKING CHANGE:, Refs:, Fixes:) are exempt, and a co-author trailer is
refused.

Verbose working commits belong on a feature branch and are discarded at the
squash-fold.
MSG
  exit 1
fi

# The repo's stated style is Conventional Commits, and until 2026-09-06 nothing
# here checked for a type at all: "TestFlight has left: remove the in-repo copy"
# passed, and six such subjects reached staging. The scope pattern allows
# SPACES, because `test(space centre):` and `fix(kerbalism uplink):` are already
# in use and a stricter pattern would reject the history it is meant to protect.
case "$subject" in
  "Revert "*|"Merge "*) ;;
  *)
    if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .'; then
      cat >&2 <<MSG
commit-msg: refusing a subject with no Conventional Commits type.

  $subject

staging history becomes release notes, and the type is what sorts a change into
them. Start with one of:
  feat fix docs style refactor perf test build ci chore revert
optionally scoped, e.g. fix(rail): or test(space centre):, then ": " and the
change in the imperative.
MSG
      exit 1
    fi
    ;;
esac

# A subject is ONE changelog line: 100 characters is what a reader takes in at a
# glance.
max_subject=100
case "$subject" in
  "Revert "*|"Merge "*) ;;
  *)
    if [ "${#subject}" -gt "$max_subject" ] && [ "$carried_subject" -eq 0 ]; then
      cat >&2 <<MSG
commit-msg: refusing a subject of ${#subject} characters (the limit is $max_subject).

  $subject

staging history becomes release notes, and the subject is the line a reader who
was not here has to take in at a glance. Keep the change in the subject and put
the rest on the ticket. For example, instead of:

  fix(mod): the stopped-clock rule holds until a flight's vessels are built, where it let go when the flight's scene stood

write:

  fix(mod): hold the stopped clock until a flight's vessels are built
MSG
      exit 1
    fi
    ;;
esac
