<Project Sdk="Microsoft.NET.Sdk">
  <!-- Run by scripts/uplink-routing-probe.mjs and never shipped: loads released
       Uplink plugins into the real engine and asks how it routes what they
       declared. net10.0 because it is a console tool on the build machine, as
       ScaffoldProbeHost is. WsTestHarness (which asserts with xunit) is linked in rather than copied so the
       client the probe subscribes with is the one the integration tests use. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>UplinkRoutingProbe</RootNamespace>
    <AssemblyName>UplinkRoutingProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\mod\Sitrep.Host\Sitrep.Host.csproj" />
    <PackageReference Include="xunit.assert" Version="2.9.2" />
    <Compile Include="..\..\mod\Sitrep.Host.IntegrationTests\WsTestHarness.cs" Link="WsTestHarness.cs" />
  </ItemGroup>
</Project>
