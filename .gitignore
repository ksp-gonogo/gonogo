node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local
.dev-build-cache/
# `pnpm build` bundles the uplink clients into the app's static assets; it's
# build output, not source. Left untracked it made a dev who built before
# committing trip the pre-commit biome check on the bundled JS.
packages/app/public/uplinks/

# tsup bundles tsup.config.ts to a transient .mjs during ui-kit (and other)
# builds; untracked it trips the same pre-commit biome check. Not source.
**/tsup.config.bundled_*.mjs
coverage/
.DS_Store
memory/
local_docs/
.claude/
/test-results/
/playwright-report/
.playwright-mcp/
# Superpowers process artifacts (design specs + implementation plans) stay
# local, like .superpowers/ scratch: they're working docs, not repo history.
docs/superpowers/
.superpowers/
# C# / .NET build outputs
bin/
# ...except a JS package's `bin/`, which is source. The .NET rule above matches
# a directory of that name at any depth, so ui-kit's committed CLI shim was
# silently unstageable, with `git add` reporting it as ignored rather than
# anything explaining why.
!packages/*/bin/
# ...and the sdk's, which is a JS package living under mod/. Named exactly, not
# globbed: every OTHER mod/*/bin is .NET build output and must stay ignored.
!mod/sitrep-sdk/bin/
obj/
*.dll
*.pdb
*.tgz

# Playwright output in any package (root /test-results/ is root-anchored)
**/test-results/

# Feature log: working history, not repo record. Kept on disk, untracked.
feature_log/

# Fleet-agent scaffolding: per-worktree launcher state, never repo history.
# Untracked is not enough, the em-dash and reachability gates both scan
# untracked files on purpose, so an agent's own log becomes a styleguide
# offender in whichever worktree it happens to be running.
.agent.log
.launch.sh
.startup-prompt

# `gonogo-uplink render` review output: pictures for a human, regenerated on
# demand and never a gate. The docs assets under `docs/assets/` ARE committed,
# because the generated page references them.
renders/

# `asyncapi-doc.mjs --check` writes what it WOULD have emitted beside the
# committed file so a CI log can diff the two. The committed `asyncapi.yaml` is
# tracked; this one is scratch from a failing check.
asyncapi.yaml.actual
