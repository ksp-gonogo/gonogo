node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local
.dev-build-cache/
# `pnpm build` bundles the uplink clients into the app's static assets; it's
# build output, not source. Left untracked it made a dev who built before
# committing trip the pre-commit biome check on the bundled JS.
packages/app/public/uplinks/

# tsup bundles tsup.config.ts to a transient .mjs during ui-kit (and other)
# builds; untracked it trips the same pre-commit biome check. Not source.
**/tsup.config.bundled_*.mjs
coverage/
.DS_Store
memory/
local_docs/
.claude/
/test-results/
/playwright-report/
.playwright-mcp/
# Superpowers process artifacts (design specs + implementation plans) stay
# local, like .superpowers/ scratch: they're working docs, not repo history.
docs/superpowers/
.superpowers/
# C# / .NET build outputs
bin/
obj/
*.dll
*.pdb
*.tgz

# Playwright output in any package (root /test-results/ is root-anchored)
**/test-results/

# Feature log: working history, not repo record. Kept on disk, untracked.
feature_log/

# Fleet-agent scaffolding: per-worktree launcher state, never repo history.
# Untracked is not enough, the em-dash and reachability gates both scan
# untracked files on purpose, so an agent's own log becomes a styleguide
# offender in whichever worktree it happens to be running.
.agent.log
.launch.sh
.startup-prompt
