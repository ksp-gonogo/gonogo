{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // bakedClientHash reads each Uplink's ExpectedClientHash.g.cs and runs
    // scripts/uplink-matrix.mjs; topic-cs-sync walks mod/ for the C# topic ids;
    // setupGuide holds the README and the static home page to the app's run command.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/mod/**/bin/Debug/**",
        "!$TURBO_ROOT$/mod/**/bin/Release/**",
        "!$TURBO_ROOT$/mod/**/obj/**",
        "!$TURBO_ROOT$/mod/**/dist/**",
        "!$TURBO_ROOT$/mod/**/.turbo/**",
        "!$TURBO_ROOT$/mod/**/node_modules/**",
        "!$TURBO_ROOT$/mod/**/coverage/**",
        "$TURBO_ROOT$/scripts/uplink-matrix.mjs",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/homepage/index.html"
      ]
    }
  }
}
