{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // collectionTopics walks mod/ for every generated topic map.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/mod/**/bin/Debug/**",
        "!$TURBO_ROOT$/mod/**/bin/Release/**",
        "!$TURBO_ROOT$/mod/**/obj/**",
        "!$TURBO_ROOT$/mod/**/dist/**",
        "!$TURBO_ROOT$/mod/**/.turbo/**",
        "!$TURBO_ROOT$/mod/**/node_modules/**",
        "!$TURBO_ROOT$/mod/**/coverage/**"
      ]
    }
  }
}
