{
  "name": "@ksp-gonogo/components",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "unfed-snapshot-gate": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/unfed-snapshot-gate.ts",
    "probe-render-smoke": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/probe-render-smoke.ts",
    "overlap-gate": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/overlap-gate.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test-d.json",
    "render-ship-map": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-fixtures.ts",
    "render-navball": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-navball.ts",
    "render-navball-gif": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-navball-gif.ts",
    "render-promoted-assets": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-promoted-assets.ts",
    "render-navball-scaling": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-navball-scaling.ts",
    "render-widget": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-widget.ts",
    "render-affordability": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-affordability.ts",
    "render-alarm-banner": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-alarm-banner.ts",
    "render-provenance-card": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-provenance-card.ts",
    "render-delay-rail": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-delay-rail.ts",
    "render-crew-status-panel-badge": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-crew-status-panel-badge.ts",
    "render-crew-status-avatar": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-crew-status-avatar.ts",
    "render-cross-browser": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-cross-browser.ts",
    "render-systemview-traffic-video": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-systemview-traffic-video.ts",
    "render-systemview-cme-video": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-systemview-cme-video.ts",
    "visual-gate": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/visual-gate.ts",
    "render-contact-timeline": "TSX_TSCONFIG_PATH=tsconfig.json tsx scripts/render-contact-timeline.ts"
  },
  "dependencies": {
    "@ksp-gonogo/core": "workspace:*",
    "@ksp-gonogo/data": "workspace:*",
    "@ksp-gonogo/logger": "workspace:*",
    "@ksp-gonogo/sitrep-client": "workspace:*",
    "@ksp-gonogo/ui": "workspace:*",
    "@ksp-gonogo/ui-kit": "workspace:*",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@ksp-gonogo/gonogo-kerbalism-uplink": "workspace:*",
    "@ksp-gonogo/gonogo-kos-uplink": "workspace:*",
    "@ksp-gonogo/gonogo-realantennas-uplink": "workspace:*",
    "@ksp-gonogo/sitrep-sdk": "workspace:*",
    "@ksp-gonogo/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
