{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // promoted-widgets.refresh-paths reads the workflow that refreshes them.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/refresh-promoted-assets.yml"
      ]
    }
  }
}
