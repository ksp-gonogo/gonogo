// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Objectives DOM snapshots > contracts-only @ default-5x8 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>OBJECTIVES</h3></div></div><div><ul aria-label="Objectives" style="list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: var(--space-4);"><li style="display: flex; gap: var(--space-6); align-items: baseline; opacity: 0.6;"><span style="font-size: var(--font-size-xs); color: var(--color-text-muted);" aria-hidden="true">○</span><div style="display: flex; flex-direction: column; gap: var(--space-hair); min-width: 0px; flex: 1 1 auto;"><span style="font-size: var(--font-size-xs);">Test LV-909: Flying over Kerbin</span><span style="font-size: var(--font-size-2xs); color: var(--color-text-muted); letter-spacing: 0.03em;">Test the LV-909 in flight</span></div><span>pending</span></li><li style="display: flex; gap: var(--space-6); align-items: baseline; opacity: 0.6;"><span style="font-size: var(--font-size-xs); color: var(--color-text-muted);" aria-hidden="true">○</span><div style="display: flex; flex-direction: column; gap: var(--space-hair); min-width: 0px; flex: 1 1 auto;"><span style="font-size: var(--font-size-xs);">Recover the stranded Kerbal</span><span style="font-size: var(--font-size-2xs); color: var(--color-text-muted); letter-spacing: 0.03em;">Rescue a Kerbal from orbit</span></div><span>pending</span></li><li style="display: flex; gap: var(--space-6); align-items: baseline; opacity: 0.6;"><span style="font-size: var(--font-size-xs); color: var(--color-text-muted);" aria-hidden="true">○</span><div style="display: flex; flex-direction: column; gap: var(--space-hair); min-width: 0px; flex: 1 1 auto;"><span style="font-size: var(--font-size-xs);">Bring them home</span><span style="font-size: var(--font-size-2xs); color: var(--color-text-muted); letter-spacing: 0.03em;">Rescue a Kerbal from orbit</span></div><span>pending</span></li></ul></div><div><div role="status">No active objectives</div></div></div><div data-panel-ghost="" aria-hidden="true"></div><div></div><div></div></div></div>"`;

