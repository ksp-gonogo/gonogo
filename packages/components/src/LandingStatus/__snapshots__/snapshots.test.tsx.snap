exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>—<span>BURN GO IN</span></div></div><span>RT 2s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Kerbin · atmospheric</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Descent envelope</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="192" height="586" role="img" aria-label="Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the terminal curve, reaching the ground at 9 m/s; 220 m/s at 28 km, below terminal; SAFE, no action needed" style="font-family: monospace; overflow: visible; display: block;"><title>Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the termin