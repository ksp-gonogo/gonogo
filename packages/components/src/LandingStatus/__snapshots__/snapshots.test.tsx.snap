exports[`LandingStatus DOM snapshots > pre-burn-cruise @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><span data-tooltip="How the vessel's link to the ground is carrying this descent" aria-description="How the vessel's link to the ground is carrying this descent" tabindex="0">STAGED</span></div></details></div></div></div><div><div data-section-full=""><div><div role="status" aria-live="polite"><div><div><span data-figure="">T−4min 2s</span><span>BURN GO IN</span></div><div><span data-figure="">0 <span data-unit="m/s" data-tooltip="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">8s</span></span></div></div><div data-section-full=""><span>Mun · vacuum</span></div><div data-section-full=""><div style="display: flex; align-items: stretch; gap: var(--gap-section);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="45000" aria-valuemin="40500" aria-valuemax="45450" aria-valuetext="45.0 kilometres; burn zone 0.0 metres to 7.4 kilometres; ground 0.0 metres; sea level -120.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="19