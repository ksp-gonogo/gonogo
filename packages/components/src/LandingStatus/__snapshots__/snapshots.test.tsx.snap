exports[`LandingStatus DOM snapshots > final-approach-mun @ landscape-18x6 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div></div></div><div><div data-section-full=""><div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-related); width: 100%;"><div role="status" aria-live="polite"><div><div><span data-figure="">T−10s</span><span>SUICIDE BURN</span></div><div><span data-figure="">0 <span data-unit="m/s" data-tooltip="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>BEST-BURN IMPACT</span></div></div></div><span style="margin-left: auto; display: flex; align-items: center; gap: var(--gap-related);"><span>LIVE</span></span></div></div><div data-section-full=""><span>Mun · vacuum</span></div><div data-section-full=""><div style="display: flex; align-items: stretch; gap: var(--gap-section);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="180" aria-valuemin="18" aria-valuemax="196.2" aria-valuetext="180.0 metres; burn zone 0.0 metres to 17.5 metres; ground 0.0 metres; sea level -0.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g><rect x="2" y="208" width="10" height="0" fill="var(--color-nogo-text)" opacity="0.55"></rect></g><g data-level="sea"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-info-mark