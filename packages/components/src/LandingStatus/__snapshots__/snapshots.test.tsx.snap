play: flex; position: relative; min-height: 0px; min-width: 0px; flex-direction: column;"><div style="flex: 1 1 0%; min-height: 0px; min-width: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Touchdown view; the ground seen from the vessel looking at the predicted site, 20° field of view" style="font-family: var(--font-family-mono); overflow: visible; display: block;"><defs><clipPath id="plot-layer-clip-:rid0:"><rect x="1" y="1" width="470" height="518"></rect></clipPath></defs><rect x="1" y="1" width="470" height="518" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rid0:)"><g data-plot-layer="terrain" data-plot-layer-kind="relief" shape-rendering="crispEdges" opacity="0.85" aria-hidden="true"><rect x="1" y="509.75" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="500.5" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="491.25" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="482" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="472.75" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="463.5" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="454.25" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="445" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="435.75" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="426.5" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="417.25" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="408" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="398.75" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="389.5" width="470.5" height="9.75" fill="rgb(49, 63, 62)"></rect><rect x="1" y="380.25" width="470.5" height="9.75" fill