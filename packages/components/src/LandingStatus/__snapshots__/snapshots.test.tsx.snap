exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>—<span>BURN GO IN</span></div></div><span>RT 2s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Kerbin · atmospheric</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Descent envelope</div><div style="display: flex; flex-direction: column; max-height: 300px; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="192" height="586" role="img" aria-label="Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the terminal curve, reaching the ground at 9 m/s; 220 m/s at 28 km, below terminal; SAFE, no action needed" style="font-family: monospace; overflow: visible; display: block;"><title>Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the terminal curve, reaching the ground at 9 m/s; 220 m/s at 28 km, below terminal; SAFE, no action needed</title><defs><clipPath id="plot-layer-clip-:r1g:"><rect x="35" y="10" width="143" height="548"></rect></clipPath></defs><rect x="35" y="10" width="143" height="548" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:r1g:)"><defs><linearGradient id="plot-field-atmosphere-base-:r1g:" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0.00%" stop-color="#5a8fd8" stop-opacity="0.12"></stop><stop offset="100.00%" stop-color="#5a8fd8" stop-opacity="0.12"></stop></linearGradient></defs><rect data-plot-layer="atmosphere-base" data-plot-layer-kind="field" x="35" y="10" width="143" height="548" fill="url(#plot-field-atmosphere-base-:r1g:)"></rect><defs><linearGradient id="plot-field-atmosphere-bands-:r1g:" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0.00%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="2.08%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="4.17%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="6.25%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="8.33%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="10.42%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="12.50%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="14.58%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="16.67%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="18.75%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="20.83%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="22.92%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="25.00%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="27.08%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="29.17%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="31.25%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="33.33%" stop-color="#5a8fd8" stop-opacit