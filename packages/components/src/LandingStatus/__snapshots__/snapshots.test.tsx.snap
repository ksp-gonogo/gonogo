exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ landscape-18x5 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>—<span>BURN GO IN</span></div></div><span>RT 2s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Kerbin · atmospheric</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 0px; width: 100%;"><div role="meter" aria-label="Altitude above terrain" aria-valuenow="28000" aria-valuemin="0" aria-valuemax="50000" aria-valuetext="28000 m" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: monospace;"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-text-primary)" stroke-width="2"></line><g><line x1="16" y1="208" x2="12" y2="208" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="208" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">0</text></g><g><line x1="16" y1="159" x2="12" y2="159" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="159" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">12500</text></g><g><line x1="16" y1="110" x2="12" y2="110" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="110" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">25000</text></g><g><line x1="16" y1="61" x2="12" y2="61" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="61" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">37500</text></g><g><line x1="16" y1="12" x2="12" y2="12" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="12" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">50000</text></g><line x1="-4" y1="98.24" x2="18" y2="98.24" stroke="var(--color-accent-fg)" stroke-width="2"></line><text x="20" y="98.24" text-anchor="start" dominant-baseline="middle" font-size="11" font-weight="bold" fill="var(--color-accent-fg)">28000</text><text x="7" y="9" text-anchor="middle" font-size="8" fill="var(--color-text-faint)">m</text></svg></div></div><div style="align-self: stretch;"><span>no burn</span></div></div></div><div style="flex: 1 1 0%; min-width: 0px;"><div><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Descent envelope</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="712" height="157" role="img" aria-label="Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the terminal curve, reaching the ground at 9 m/s; 220 m/s at 28 km, below terminal; SAFE, no action needed" style="font-family: monospace; overflow: visible; display: block;"><title>Descent envelope; the region right of the terminal curve is decelerating: drag exceeds weight there; terminal velocity 220 m/s at 28 km, projected touchdown 8 m/s; projected descent never settles onto the terminal curve, reaching the ground at 9 m/s; 220 m/s at 28 km, below terminal; SAFE, no action needed</title><defs><clipPath id="plot-layer-clip-:rr:"><rect x="50" y="10" width="642" height="119"></rect></clipPath></defs><rect x="50" y="10" width="642" height="119" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rr:)"><defs><linearGradient id="plot-field-atmosphere-base-:rr:" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0.00%" stop-color="#5a8fd8" stop-opacity="0.12"></stop><stop offset="100.00%" stop-color="#5a8fd8" stop-opacity="0.12"></stop></linearGradient></defs><rect data-plot-layer="atmosphere-base" data-plot-layer-kind="field" x="50" y="10" width="642" height="119" fill="url(#plot-field-atmosphere-base-:rr:)"></rect><defs><linearGradient id="plot-field-atmosphere-bands-:rr:" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0.00%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="2.08%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="4.17%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="6.25%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="8.33%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="10.42%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="12.50%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="14.58%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="16.67%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="18.75%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="20.83%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="22.92%" stop-color="#5a8fd8" stop-opacity="0"></stop><stop offset="25.00%" stop-c