exports[`LandingStatus DOM snapshots > landed-mun @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><span data-tooltip="How the vessel's link to the ground is carrying this descent" aria-description="How the vessel's link to the ground is carrying this descent" tabindex="0">STAGED</span></div></details></div></div></div><div data-section-fill=""><div><div><div style="container-type: size; height: 100%; position: relative;"><div><div style="grid-area: rail; position: sticky; top: 0px; align-self: start; height: 100cqh; width: 64px;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="0" aria-valuemin="-120" aria-valuemax="13.100000000000001" aria-valuetext="0.0 metres; ground 0.0 metres; sea level -120.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g data-level="sea"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-info-mark)" stroke-width="1.5" stroke-dasharray="3 2"></line></g><g data-level="ground"><line x1="-2" y1="31.290758827948903" x2="16" y2="31.290758827948903" stroke="var(--color-text-primary)" stroke-width="2"></line></g><g><line x1="16" y1="178.54845980465814" x2="12" y2="178.54845980465814" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="178.54845980465814" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">-100.0</text></g><g><line x1="16" y1="104.91960931630352" x2="12" y2="104.91960931630352" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="104.91960931630352" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">-50.0</text></g><g><line x1="16" y1="31.290758827948903" x2="12" y2="31.290758827948903" stroke="var(--color-border-subtle)" stroke-width="1"></line></g><line x1="-4" y1="31.290758827948903" x2="18" y2="31.290758827948903" stroke="var(--color-accent-fg)" stroke-width="2"></line><text x="20" y="31.290758827948903" text-anchor="start" dominant-baseline="middle" font-size="11" font-weight="bold" fill="var(--color-accent-fg)">0.0</text><text x="7" y="9" text-anchor="middle" font-size="8" fill="var(--color-text-faint)">m</text></svg></div></div><div style="align-self: stretch;"><span>no burn</span></div></div></div><div style="grid-area: header; min-width: 0px;"><div><div><div role="status" aria-live="polite"><div><div>LANDED<span>TOUCHDOWN CONFIRMED</span></div><div>—<span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">8s</span></span></div><span>Mun · vacuum</span></div></div><div><div style="display: flex; flex-direction: column; gap: var(--gap-related); flex: 1 1 auto; min-height: 0px;"><div data-plot-board=""><div><div data-grid-squares=""><div data-plot-cell="" style="display: flex; align-items: center; justify-content: center;"><div style="width: min(100cqw, 100cqh - 17px - var(--gap-related)); display: flex; flex-direction: column; gap: var(--gap-related);"><div data-plot-heading="" style="min-width: 0px; height: 17px;"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Touchdown view">Touchdown view</div></div><div data-plot-square="" style="display: flex; flex-direction: column; width: 100%; aspect-ratio: 1 / 1; min-height: 0px;"><div style="flex: 1 1 0%; display: flex; position: relative; min-height: 0px; min-width: 0px; flex-direction: column;"><div style="flex: 1 1 0%; min-height: 0px; min-width: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="508" role="img" aria-label="Touchdown view; the ground seen from the vessel looking at the predicted site, 20° field of view" style="font-family: var(--font-family-mono); overflow: visible; display: block;"><defs><clipPath id="plot-layer-clip-:rid0:"><rect x="1" y="1" width="470" height="506"></rect></clipPath></defs><rect x="1" y="1" width="470" height="506" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rid0:)"><g data-plot-layer="terrain" data-plot-layer-kind="relief" shape-rendering="crispEdges" opacity="0.85" aria-hidden="true"><rect x="1" y="497.9642857142858" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="488.92857142857144" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="479.89285714285717" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="470.8571428571429" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="461.8214285714286" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="452.78571428571433" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="443.75000000000006" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="434.7142857142858" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="425.67857142857144" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="416.64285714285717" width="470.5" height="9.535714285714286" fill="rgb(49, 63, 62)"></rect><rect x="1" y="407.6071428571429" width="470.5" height="9.53571428571428