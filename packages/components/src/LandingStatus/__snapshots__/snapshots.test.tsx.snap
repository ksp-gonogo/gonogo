exports[`LandingStatus DOM snapshots > suicide-burn-approaching @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>T−14s<span>BURN GO IN</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Cross-section</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="192" height="586" role="img" aria-label="Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at -3 m elevation; vessel 3 km above terrain; descending 43 m/s, ground speed 50 m/s, projected 10s ahead" style="font-family: monospace; overflow: visible; display: block;"><title>Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at -3 m elevation; vessel 3 km above terrain; descending 43 m/s, ground speed 50 m/s, projected 10s ahead</title><defs><clipPath id="plot-layer-clip-:rid0:"><rect x="1" y="1" width="190" height="584