exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div></div></div><div><div data-section-full=""><div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-related); width: 100%;"><div role="status" aria-live="polite"><div><div>—<span>BURN GO IN</span></div><div>—<span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">2s</span></span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--gap-related);"><span>STAGED</span></span></div></div><div data-section-full=""><span>Kerbin · atmospheric</span></div><div data-section-full=""><div style="display: flex; align-items: stretch; gap: var(--gap-section);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="28000" aria-valuemin="23792" aria-valuemax="28420.8" aria-valuetext="28.0 kilometres; ground 0.0 metres; sea level -0.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g data-level="sea"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-info-mark)" stroke-width="1.5" stroke-dasharray="3 2"></line><polygon data-off-scale="true" points="3,206 11,206 7,212" fill="var(--color-info-mark)"></polygon></g><g data-level="ground"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-text-primary)" stroke-width="2"></line><p