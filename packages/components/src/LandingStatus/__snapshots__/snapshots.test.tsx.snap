exports[`LandingStatus DOM snapshots > pre-burn-cruise @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>T−1min 37s<span>BURN GO IN</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div style="display: flex; flex-direction: column;"><div style="padding: var(--space-8) 0;"><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Altitude</div><div style="display: flex; flex-direction: column; max-height: 300px; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Altitude; suicide burn must begin by 37 km above terrain; 45.0 km above terrain; ignition in 1min 46s" style="font-family: monospace; overflow: visible; display: block;"><title>Altitude; suicide burn must begin by 37 km above terrain; 45.0 km above terrain; ignition in 1min 46s</title><defs><clipPath id="plot-layer-clip-:r0:"><rect x="50" y="10" width="402" height="482"></rect></clipPath></defs><rect x="50" y="10" width="402" height="482" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-lay