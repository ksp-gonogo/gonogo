x-direction: column; gap: var(--gap-related);"><div data-plot-columns="2" style="display: grid; grid-template-columns: repeat(2, 236px); gap: var(--gap-related);"><div style="min-width: 0px; display: flex; flex-direction: column; gap: var(--gap-related);"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Cross-section">Cross-section</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; display: flex; position: relative; min-height: 0px; min-width: 0px; flex-direction: column;"><div style="flex: 1 1 0%; min-height: 0px; min-width: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at 120 m elevation; vessel 180 m above terrain; the burn lit now adds 36 m/s to the speed over 10s; the engine fires the opposite way; descending 8 m/s, ground speed 2 m/s, projected 10s ahead" style="font-family: var(--font-family-mono); overflow: visible; display: block;"><title>Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at 120 m elevation; vessel 180 m above terrain; the burn lit now adds 36 m/s to the speed over 10s; the engine fires the opposite way; descending 8 m/s, ground speed 2 m/s, projected 10s ahead</title><defs><clipPath id="plot-layer-clip-:rid0:"><rect x="1" y="1" width="470" height="518"></rect></clipPath></defs><rect x="1" y="1" width="470" height="518" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rid0:)"><polygon data-plot-layer="ground" data-plot-layer-kind="region" points="-18.81,380.13 3.36,379.88 25.53,379.48 47.71,378.81 69.88,377.79 92.06,376.38 114.23,374.52 136.40,372.23 158.58,369.52 180.75,366.44 202.93,363.06 225.10,359.50 247.27,355.85 269.45,352.23 291.62,348.76 