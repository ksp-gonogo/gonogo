ration</span><span>4s</span></div><div style="display: flex; flex-direction: column;"><span>Available dV</span><span><span>900 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column; align-items: start;"><span>Affordable</span><span>yes</span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (coast)</span><span><span>25.6 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (burn now)</span><span><span>0.00 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Impact in</span><span>10s</span></div></div></div><div><div>Height</div><div><span>AGL</span><span><span>180 <span data-unit="m" title="metres"><span aria-hidden="true">m</span><span data-unit-word=""> metres</span></span></span></span></div></div></div></div></div></div><div></div><div></div></div></div>"`;

exports[`LandingStatus DOM snapshots > high-speed-no-solution @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="alert" aria-live="assertive"><div>NO LANDING VECTOR</div><div><span>279 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>UNAVOIDABLE IMPACT</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div style="display: flex; flex-direction: column;"><div style="padding: var(--space-8) 0;"><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Altitude</div><div style="display: flex; flex-direction: column; max-height: 300px; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Altitude; 12.0 km above terrain; past the latest ignition point" style="font-family: monospace; overflow: visible; display: block;"><title>Altitude; 12.0 km above terrain; past the latest ignition point</title><defs><clipPath id="plot-layer-clip-:r1k:"><rect x="50" y="10" width="402" height="482"></rect></clipPath></de