le</span><span>yes</span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (coast)</span><span><span>115 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (burn now)</span><span><span>0.00 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Impact in</span><span>38s</span></div></div></div><div><div>Height</div><div><span>AGL</span><span><span>2.80 <span data-unit="km" title="kilometres"><span aria-hidden="true">km</span><span data-unit-word=""> kilometres</span></span></span></span></div></div></div></div></div></div><div></div><div></div></div></div>"`;
