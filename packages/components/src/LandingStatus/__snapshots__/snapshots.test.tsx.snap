exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><span data-tooltip="How the vessel's link to the ground is carrying this descent" aria-description="How the vessel's link to the ground is carrying this descent" tabindex="0">STAGED</span></div></details></div></div></div><div data-section-fill="" style="margin-bottom: calc(-1 * var(--panel-body-bottom));"><div><div><div style="container-type: size; height: 100%; position: relative; padding-bottom: var(--panel-body-bottom);"><div><div style="grid-area: header; min-width: 0px;"><div><div><div role="status" aria-live="polite"><div><div>—<span>BURN GO IN</span></div><div>—<span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">2s</span></span></div><span>Kerbin · atmospheric</span></div></div><div><div style="display: flex; flex-direction: column; gap: var(--gap-related); flex: 1 1 auto; min-height: 0px;"><div data-plot-board=""><div><div data-grid-squares=""><div data-plot-cell="" style="display: flex; align-items: center; justify-content: center;"><div style="width: min(100cqw, 100cqh - 17px - var(--gap-related)); display: flex; flex-direction: column; gap: var(--gap-related);"><div data-plot-heading="" style="min-width: 0px; height: 17px;"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Touchdown view">Touchdown view</div></div><div data-plot-square="" style="display: flex; flex-direction: column; width: 100%; aspect-ratio: 1 / 1; min-height: 0px;"><div style="flex: 1 1 0%; display: flex; position: relative; min