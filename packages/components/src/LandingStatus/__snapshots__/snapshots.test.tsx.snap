exports[`LandingStatus DOM snapshots > suicide-burn-approaching @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>T−14s<span>BURN GO IN</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 0px; width: 100%;"><div role="meter" aria-label="Altitude above terrain" aria-valuenow="2800" aria-valuemin="0" aria-valuemax="5000" aria-valuetext="2800 m" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: monospace;"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g><rect x="2" y="138.53158229190302" width="10" height="69.46841770809698" fill="var(--color-status-nogo-fg)" opacity="0.55"></rect><text x="-4" y="173.2657911459515" text-anchor="end" dominant-baseline="middle" font-size="9" fill="var(--color-text-faint)">burn</text></g><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-text-primary)" stroke-width="2"></line><g><line x1="16" y1="208" x2="12" y2="208" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="208" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">0</text></g><g><line x1="16" y1="159" x2="12" y2="159" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="159" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">1250</text></g><g><line x1="16" y1="110" x2="12" y2="110" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="110" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">2500</text></g><g><line x1="16" y1="61" x2="12" y2="61" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="61" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">3750</text></g><g><line x1="16" y1="12" x2="12" y2="12" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="12" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">5000</text></g><line x1="-4" y1="98.24" x2="18" y2="98.24" stroke="var(--color-accent-fg)" stroke-width="2"></line><text x="20" y="98.24" text-anchor="start" dominant-baseline="middle" font-size="11" font-weight="bold" fill="var(--color-accent-fg)">2800</text><text x="7" y="9" text-anchor="middle" font-size="8" fill="var(--color-text-faint)">m</text></svg></div></div><div style="align-self: stretch;"><span>ignite in 19s</span></div></div></div><div style="flex: 1 1 0%; min-width: 0px;"><div style="display: flex; flex-direction: column;"><div style="padding: var(--space-8) 0;"><div style="display: flex; flex-direction: column; gap: var(--space-6);"><div style="display: flex; flex-wrap: wrap; gap: var(--space-6);"><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Cross-section</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min