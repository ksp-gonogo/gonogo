exports[`LandingStatus DOM snapshots > descending-too-fast-to-stop @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div></div></div><div><div data-section-full=""><div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-related); width: 100%;"><div role="alert" aria-live="assertive"><div><div>NO LANDING VECTOR</div><div><span data-figure="">279 <span data-unit="m/s" data-tooltip="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">8s</span></span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--gap-related);"><span>STAGED</span></span></div></div><div data-section-full=""><span>Mun · vacuum</span></div><div data-section-full=""><div style="display: flex; align-items: stretch; gap: var(--gap-section);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="12000" aria-valuemin="5000" aria-valuemax="28140.8166" aria-valuetext="12.0 kilometres; burn zone 0.0 metres to 26.0 kilometres; ground 0.0 metres; sea level -0.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g><rect x="2" y="29.818181818181802" width="10" height="178.1818181818182" fill="var(--color-nogo-text)" opacity="0.55"></rect></g><g data-level="sea"><line x1