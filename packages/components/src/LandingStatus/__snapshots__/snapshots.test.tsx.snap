exports[`LandingStatus DOM snapshots > suicide-burn-approaching @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="status" aria-live="polite"><div>T−14s<span>BURN GO IN</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div><div>Velocity</div><div><span>Vertical</span><span><span>42.5 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span><span>Horizontal</span><span><span>50.0 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div></div><div><div><div style="display: flex; flex-direction: column;"><span>Burn dV</span><span><span>114 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Burn duration</span><span>30s</span></div><div style="display: flex; flex-direction: column;"><span>Available dV</span><span><span>900 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column; align-items: start;"><span>Affordable</span><span>yes</span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (coast)</span><span><span>115 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (burn now)</span><span><span>0.00 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Impact in</span><span>38s</span></div></div></div><div><div>Height</div><div><span>AGL</span><span><span>2.80 <span data-unit="km" title="kilometres"><span aria-hidden="true">km</span><span data-unit-word=""> kilometres</span></span></span></span></div></div></div></div></div></div><div></div><div></div></div></div>"`;
