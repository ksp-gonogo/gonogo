exports[`LandingStatus DOM snapshots > final-approach-mun @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div></div></div><div data-section-fill=""><div><div><div style="container-type: size; height: 100%; position: relative;"><div><div style="grid-area: rail; position: sticky; top: 0px; align-self: start; height: 100cqh; width: 64px;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="180" aria-valuemin="18" aria-valuemax="196.2" aria-valuetext="180.0 metres; burn zone 0.0 metres to 17.5 metres; ground 0.0 metres; sea level -120.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g><rect x="2" y="208" width="10" height="0" fill="var(--color-nogo-text)" opacity="0.55"></rect></g><g data-level="sea"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-info-mark)" stroke-width="1.5" stroke-dasharray="3 2"></line><polygon data-off-scale="true" points="3,206 11,206 7,212" fill="var(--color-info-mark)"></polygon></g><g data-level="ground"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-text-primary)" stroke-width="2"></line><polygon data-off-scale="true" points="3,206 11,206 7,212" fill="var(--color-text-primary)"></polygon></g><g><line x1="16" y1="172.8035914702581" x2="12" y2="172.8035914702581" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="172.8035914702581" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">50.0</text></g><g><line x1="16" y1="117.80920314253648" x2="12" y2="117.80920314253648" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="117.80920314253648" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">100.0</text></g><g><line x1="16" y1="62.8148148148148" x2="12" y2="62.8148148148148" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="62.8148148148148" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">150.0</text></g><line x1="-4" y1="29.818181818181802" x2="18" y2="29.818181818181802" stroke="var(--color-accent-fg)" stroke-width="2"></line><text x="20" y="29.818181818181802" text-anchor="start" dominant-baseline="middle" font-size="11" font-weight="bold" fill="var(--color-accent-fg)">180.0</text><text x="7" y="9" text-anchor="middle" font-size="8" fill="var(--color-text-faint)">m</text></svg></div></div><div style="align-self: stretch;"><span>burning</span></div></div></div><div style="grid-area: header; min-width: 0px;"><div><div><div role="status" aria-live="polite"><div><div>BURNING</div><div><span data-figure="">0 <span data-unit="m/s" data-tooltip="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>BEST-BURN IMPACT</span></div></div></div></div><span>Mun · vacuum</span></div></div><div><div style="display: flex; flex-direction: column; gap: var(--gap-related); flex: 1 1 auto; min-height: 0px;"><div data-plot-board=""><div><div data-grid-squares=""><div data-plot-cell="" style="display: flex; align-items: center; justify-content: center;"><div style="width: min(100cqw, 100cqh - 17px - var(--gap-related)); display: flex; flex-direction: column; gap: var(--gap-related);"><div data-plot-heading="" style="min-width: 0px; height: 17px;"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Touchdown view">To