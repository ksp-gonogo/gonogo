" stroke="var(--color-accent-fg)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></polyline></g><g data-plot-layer="ignition-cue" data-plot-layer-kind="caption" text-anchor="start"><text x="56" y="474" font-size="9" letter-spacing="0.05em" fill="var(--color-text-faint)">ignite in</text><text x="56" y="486" font-size="10" font-weight="700" fill="var(--color-status-warning-bg)" fill-opacity="0.85">19s</text></g></svg></div></div></div></div><div style="flex: 1 1 200px; min-width: 200px; display: flex; flex-direction: column; gap: var(--space-4);"><div>Cross-section</div><div style="display: flex; flex-direction: column; max-height: 300px; min-height: 0px;"><div style="flex: 1 1 0%; min-height: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at -3 m elevation; vessel 3 km above terrain; descending 43 m/s, ground speed 50 m/s, projected 10s ahead" style="font-family: monospace; overflow: visible; display: block;"><title>Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at -3 m elevation; vessel 3 km above terrain; descending 43 m/s, ground speed 50 m/s, projected 10s ahead</title><defs><clipPath id="plot-layer-clip-:rd:"><rect x="50" y="10" width="402" height="482"></rect></clipPath></defs><rect x="50" y="10" width="402" height="482" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rd:)"><polygon data-plot-layer="ground" data-plot-layer-kind="region" points="358.89,453.27 360.26,453.19 361.62,453.11 362.98,453.03 364.34,453.02 365.70,453.03 367.07,453.04 368.43,453.15 369.79,453.35 371.15,453.54 372.51,453.69 373.88,453.75 375.24,453.81 376.60,453.87 377.96,453.93 379.33,453.99 380.69,454.04 382.05,454.35 383.41,454.66 384.77,454.97 386.14,455.26 387.50,455.55 38