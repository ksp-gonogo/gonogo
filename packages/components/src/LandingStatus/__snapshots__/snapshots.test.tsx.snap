ap: var(--gap-related);"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Cross-section">Cross-section</div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; display: flex; position: relative; min-height: 0px; min-width: 0px; flex-direction: column;"><div style="flex: 1 1 0%; min-height: 0px; min-width: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="472" height="520" role="img" aria-label="Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at 120 m elevation; vessel 3 km above terrain; the burn lit now adds 36 m/s to the speed over 10s; the engine fires the opposite way; descending 43 m/s, ground speed 50 m/s, projected 10s ahead" style="font-family: var(--font-family-mono); overflow: visible; display: block;"><title>Cross-section; terrain below the ground track; terrain profile along the ground track; predicted touchdown site at 120 m elevation; vessel 3 km above terrain; the burn lit now adds 36 m/s to the speed over 10s; the engine fires the opposite way; descending 43 m/s, ground speed 50 m/s, projected 10s ahead</title><defs><clipPath id="plot-layer-clip-:rid0:"><rect x="1" y="1" width="470" height="518"></rect></clipPath></defs><rect x="1" y="1" width="470" height="518" fill="var(--color-surface-panel)"></rect><g clip-path="url(#plot-layer-clip-:rid0:)"><polygon data-plot-layer="ground" data-plot-layer-kind="region" points="-189.28,452.63 -101.72,454.12 -14.17,454.70 73.39,454.32 160.94,453.20 248.50,451.02 336.05,447.90 423.61,444.72 511.16,441.86 598.72,439.30 686.27,437.61 773.83,437.28 861.38,437.85 948.94,439.00 1036.49,440.88 1124.05,443.00 1211.60,444.57 1299.16,445.58 1386.71,446.18 1474.27,445.96 1561.82,444.96 1649.37,443.91 1736.93,443.04 1824.48,442.21 1912.04,441.93 1999.59,442.59 2087.15,443.69 2174.70,444.92 2262.26,446.45 2349.81,447