exports[`LandingStatus DOM snapshots > final-approach-mun @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="alert" aria-live="assertive"><div>T−1s<span>SUICIDE BURN</span></div></div><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>LIVE</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div><div>Velocity</div><div><span>Vertical</span><span><span>8.10 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span><span>Horizontal</span><span><span>2.00 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div></div><div><div><div style="display: flex; flex-direction: column;"><span>Burn dV</span><span><span>15 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Burn duration</span><span>4s</span></div><div style="display: flex; flex-direction: column;"><span>Available dV</span><span><span>900 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column; align-items: start;"><span>Affordable</span><span>yes</span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (coast)</span><span><span>25.6 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Touchdown (burn now)</span><span><span>0.00 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span></span></div><div style="display: flex; flex-direction: column;"><span>Impact in</span><span>10s</span></div></div></div><div><div>Height</div><div><span>AGL</span><span><span>180 <span data-unit="m" title="metres"><span aria-hidden="true">m</span><span data-unit-word=""> metres</span></span></span></span></div></div></div></div></div></div><div></div><div></div></div></div>"`;

exports[`LandingStatus DOM snapshots > high-speed-no-solution @ full-w12 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>LANDING</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; align-items: center; gap: var(--space-8); width: 100%;"><div role="alert" aria-live="assertive"><div>NO LANDING VECTOR</div><div><span>279 <span data-unit="m/s" title="metres per second"><span aria-hidden="true">m/s</span><span data-unit-word=""> metres per second</span></span></span><span>UNAVOIDABLE IMPACT</span></div></div><span>RT 8s</span><span style="margin-left: auto; display: flex; align-items: center; gap: var(--space-4);"><div>STAGED</div></span></div></div></details></div></div><span>Mun · vacuum</span><div style="display: flex; flex: 1 1 0%; min-height: 0px; align-items: stretch; gap: var(--space-12);"><div style="flex: 0 0 auto; width: 64px; position: sticky; top: 0px; align-self: flex-start;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 0px; width: 100%;"><div role="meter" aria-label="Altitude above terrain" aria-valuenow="12000" aria-valuemin="0" aria-valuemax="20000" aria-valuetext="12000 m" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: monospace;"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-text-primary)" stroke-width="2"></line><g><line x1="16" y1="208" x2="12" y2="208" stroke="var(--color-border-subtle)" stroke-width="1"></line><text x="18" y="208" text-anchor="start" dominant-baseline="middle" font-size="8" fill="var(--color-text-faint)">0</text></g><g><line x1="16" y1