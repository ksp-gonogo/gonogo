exports[`LandingStatus DOM snapshots > suicide-burn-approaching @ mobile-9x8 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><span data-tooltip="How the vessel's link to the ground is carrying this descent" aria-description="How the vessel's link to the ground is carrying this descent" tabindex="0">STAGED</span></div></details></div></div></div><div data-section-fill="" style="margin-bottom: calc(-1 * var(--panel-body-bottom));"><div><div><div style="container-type: size; height: 100%; position: relative; padding-bottom: var(--panel-body-bottom);"><div><div style="grid-area: rail; position: sticky; top: 0px; align-self: start; height: 100cqh; width: 64px;"><div style="display: flex; flex-direction: column; align-items: center; height: 100%; gap: 0.25rem; min-width: 0px;"><div style="flex: 1 1 0%; min-height: 120px; width: 100%;"><div data-figure="" role="meter" aria-label="Altitude above terrain" aria-valuenow="2800" aria-valuemin="1950" aria-valuemax="2885" aria-valuetext="2.8 kilometres; burn zone 0.0 metres to 1.0 kilometres; ground 0.0 metres; sea level -120.0 metres" style="height: 100%;"><svg width="64" height="220" viewBox="0 0 64 220" aria-hidden="true" style="display: block; font-family: var(--font-family-mono);"><rect x="2" y="12" width="10" height="196" rx="2" fill="var(--color-surface-raised)"></rect><g><rect x="2" y="208" width="10" height="0" fill="var(--color-nogo-text)" opacity="0.55"></rect></g><g data-level="sea"><line x1="-2" y1="208" x2="16" y2="208" stroke="var(--color-info-mark)" stroke-width="1.5" stroke-dasharray="3 2"></line><polygon data-off-scale="true" points="3,206 11,206 7,212" fill="var(