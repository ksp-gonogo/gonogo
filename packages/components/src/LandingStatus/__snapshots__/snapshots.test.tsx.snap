exports[`LandingStatus DOM snapshots > kerbin-reentry-atmospheric @ portrait-5x18 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>LANDING</h3><span aria-hidden="true"><span></span></span></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><span data-tooltip="How the vessel's link to the ground is carrying this descent" aria-description="How the vessel's link to the ground is carrying this descent" tabindex="0">STAGED</span></div></details></div></div></div><div><div data-section-full=""><div><div role="status" aria-live="polite"><div><div>—<span>BURN GO IN</span></div><div>—<span>BEST-BURN IMPACT</span></div></div></div><span>RT <span data-figure="">2s</span></span></div></div><div data-section-full=""><span>Kerbin · atmospheric</span></div><div data-section-full=""><div style="display: flex; align-items: stretch; gap: var(--gap-section);"><div style="flex: 1 1 0%; min-width: 0px;"><div><div style="display: flex; flex-direction: column; gap: var(--gap-related);"><div data-plot-columns="1" style="display: grid; grid-template-columns: repeat(1, 192px); gap: var(--gap-related);"><div style="min-width: 0px; display: flex; flex-direction: column; gap: var(--gap-related);"><div style="min-width: 0px; min-height: 17px;"><div style="min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" data-tooltip="Touchdown view">Touchdown view</div></div><div style="display: flex; flex-direction: column; min-height: 0px;"><div style="flex: 1 1 0%; display: flex; position: relative; min-height: 0px; min-width: 0px; flex-direction: column;"><div style="flex: 1 1 0%; min-height: 0px; min-width: 0px;"><div style="flex: 1 1 0%; position: relative; min-height: 0px; min-width: 0px;"><svg width="192" height="586" role="img" ari