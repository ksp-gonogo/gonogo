exports[`Navball widget DOM snapshots > banked-90-right @ landscape-18x5 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""><span aria-live="polite" aria-atomic="false" data-live-region=""></span></div><div data-panel-header=""><div><h3>NAVBALL</h3><span aria-hidden="true"><span></span></span></div></div></div><div data-section-fill="" style="flex-shrink: 0;"><div style="flex: 1 1 0%; min-height: 0px; display: flex; flex-direction: column;"><div style="display: flex; flex-direction: column; gap: var(--gap-related); flex: 1 1 0%; justify-content: center;"><div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-related);"><div style="font-size: max(var(--font-size-figure), 40px); min-width: auto; font-variant-numeric: tabular-nums; white-space: nowrap;"><span><span data-figure="">90<span data-unit="°" data-tooltip="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span><span>HDG</span></div><div style="font-size: max(var(--font-size-figure), 40px); min-width: auto; font-variant-numeric: tabular-nums; white-space: nowrap;"><span>+<span data-figure="">0<span data-unit="°" data-tooltip="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span><span>PCH</span></div><div style="font-size: max(var(--font-size-figure), 40px); min-width: auto; font-variant-numeric: tabular-nums; white-space: nowrap;"><span>+<span data-figure="">90<span data-unit="°" data-tooltip="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span><span>RLL</span></div></div></div></div></div><div><div data-section-full=""><div style="display: flex; flex-direction: column; gap: var(--gap-rows);"><div style="display: flex; flex-wrap: wrap; gap: var(--gap-related);"><button aria-pressed="false" style="flex: 1 0 auto;" type="button">SAS OFF</button><button aria-pressed="true" style="flex: 1 0 auto;