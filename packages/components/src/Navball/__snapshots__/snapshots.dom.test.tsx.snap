;" value="0"><span style="font-size: var(--font-size-xs); color: var(--color-text-primary); font-variant-numeric: tabular-nums; min-width: 36px; text-align: right;"><span>0 <span data-unit="%" title="percent"><span aria-hidden="true">%</span><span data-unit-word=""> percent</span></span></span></span></div><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(68px, 1fr)); gap: var(--space-4);"><button type="button">ZERO</button><button type="button">−10%</button><button type="button">+10%</button><button type="button">FULL</button></div></div><div style="display: flex; flex-direction: column; gap: var(--space-4);"><div style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-faint);">Fly-by-wire</div><div style="display: flex; align-items: center; gap: var(--space-8);"><button type="button" aria-pressed="false">Arm FBW</button><span style="font-size: var(--font-size-2xs); color: var(--color-text-faint);">Bind axes via the Inputs tab, then arm to take stick control.</span></div></div></div></div></div></div><div></div><div></div></div></div>"`;

exports[`Navball widget DOM snapshots > banked-90-right @ landscape-18x5 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>ATTITUDE</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: flex-end; min-width: 0px;"><span style="font-size: var(--font-size-2xs); font-weight: 700; letter-spacing: 0.08em; padding: var(--space-hair) var(--space-6); border-radius: var(--radius-xs); background: var(--color-surface-raised); color: var(--color-text-faint);">SAS: SAS</span><span style="font-size: var(--font-size-2xs); font-weight: 700; letter-spacing: 0.08em; padding: var(--space-hair) var(--space-6); border-radius: var(--radius-xs); background: var(--color-status-go-bg); color: var(--color-status-go-fg);">RCS</span><span style="font-size: var(--font-size-2xs); font-weight: 700; letter-spacing: 0.08em; padding: var(--space-hair) var(--space-6); border-radius: var(--radius-xs); background: var(--color-status-go-bg); color: var(--color-status-go-fg);">PRECISION</span></div></div></details></div></div><div data-section-fill=""><div style="display: flex; flex-direction: column; gap: var(--space-4); flex: 1 1 0%; justify-content: center;"><div style="display: flex; align-items: baseline; gap: var(--space-8);"><span style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-text-faint); min-width: 28px;">HDG</span><span style="font-size: 18px; font-weight: 700; color: var(--color-text-primary); font-variant-numeric: tabular-nums; letter-spacing: 0.04em;"><span>90<span data-unit="°" title="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span></div><div style="display: flex; align-items: baseline; gap: var(--space-8);"><span style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-text-faint); min-width: 28px;">PCH</span><span style="font-size: 18px; font-weight: 700; color: var(--color-text-primary); font-variant-numeric: tabular-nums; letter-spacing: 0.04em;">+<span>0<span data-unit="°" title="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span></div><div style="display: flex; align-items: baseline; gap: var(--space-8);"><span style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-text-faint); min-width: 28px;">RLL</span><span style="font-size: 18px; font-weight: 700; color: var(--color-text-primary); font-variant-numeric: tabular-nums; letter-spacing: 0.04em;">+<span>90<span data-unit="°" title="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span></div></div></div><div></div></div><div></div><div></div></div></div>"`;

