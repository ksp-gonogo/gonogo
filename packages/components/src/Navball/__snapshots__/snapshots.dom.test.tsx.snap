exports[`Navball widget DOM snapshots > uncontrollable-drift @ landscape-18x5 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>ATTITUDE</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div style="display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: flex-end; min-width: 0px;"><span style="font-size: var(--font-size-2xs); font-weight: 700; letter-spacing: 0.08em; padding: var(--space-hair) var(--space-6); border-radius: var(--radius-xs); background: var(--color-surface-raised); color: var(--color-text-faint);">SAS: SAS</span><span style="font-size: var(--font-size-2xs); font-weight: 700; letter-spacing: 0.08em; padding: var(--space-hair) var(--space-6); border-radius: var(--radius-xs); background: var(--color-surface-raised); color: var(--color-text-faint);">RCS</span></div></div></details></div></div><div data-section-fill=""><div style="display: flex; flex-direction: column; gap: var(--space-4); flex: 1 1 0%; justify-content: center;"><div style="display: flex; align-items: baseline; gap: var(--space-8);"><span style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-text-faint); min-width: 28px;">HDG</span><span style="font-size: 18px; font-weight: 700; color: var(--color-text-primary); font-variant-numeric: tabular-nums; letter-spacing: 0.04em;"><span>200<span data-unit="°" title="degrees"><span aria-hidden="true">°</span><span data-unit-word=""> degrees</span></span></span></span></div><div style="display: flex; align-items: baseline; gap: var(--space-8);"><span style="font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-text-faint); min-width: 28px;">PCH</span><span style="font-size: 18px; font-weight: 700; color: var(--color-text-primary); font-variant-numeric: tabular-nums; letter-spacing: 0.04em;"><span>-15<spa