exports[`ThermalStatus DOM snapshots > cruise-nominal @ default-8x7 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""></div><div data-panel-header=""><div><h3>THERMAL</h3></div></div></div><div><div data-section-full=""><div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-related);" role="status" aria-live="polite"><div style="min-width: 0px; max-width: 100%; padding: 5px 10px; letter-spacing: 0.06em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">nominal</div></div></div><div data-section-full=""><div style="gap: var(--gap-readout-groups);"><div><div style="display: flex; align-items: baseline; justify-content: space-between; gap: var(--gap-related);"><div style="font-size: var(--font-size-caption); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-dim); min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Hottest part</div><span style="flex-shrink: 0; font-size: var(--font-size-caption); letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; color: var(--color-accent-fg);">nominal</span></div><div><div><span>LV-T30 'Reliant'</span><span><span>14.4 <span data-unit="°C" title="degrees celsius"><span aria-hidden="true">°C</span><span data-unit-word=""> degrees celsius</span></span></span><span style="color: var(--color-text-faint); font-size: var(--font-size-compact); white-space: nowrap;"> / <span>1727 <span data-unit="°C" title="degrees celsius"><span aria-hidden="true">°C</span><span data-unit-word=""> degrees celsius</span></span></span> max</span></span></div><div><div role="meter" aria-label="LV-T30 'Reliant'" aria-valuenow="22" aria-valuemin="0" aria-valuemax="100" aria-valuetext="22 percent"><div style="width: 22%;"></div></div></div></div></div><div><div style="display: flex; align-items: baseline; justify-content: space-between; gap: var(--gap-related);"><div style="font-size: var(--font-size-caption); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-dim); min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Hottest engine</div><span style="flex-shrink: 0; font-size: var(--font-size-caption); letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; color: var(--color-accent-fg);">nominal</span></div><div><div><span>Temperature</span><span><span>576.9 <span data-unit="°C" title="degrees celsius"><span aria-hidden="true">°C</span><span data-unit-word=""> degrees celsius</span></span></span><span style="color: var(--color-text-faint); font-size: var(--font-size-compact); white-space: nowrap;"> / <span>2000 <span data-unit="°C" title="degrees celsius"><span aria-hidden="true">°C</span><span data-unit-word=""> degrees celsius</span></span></span> max</span></span></div><div><div role="meter" aria-label="Temperature" aria-valuenow="37" aria-valuemin="0" aria-valuemax="100" aria-valuetext="37 percent"><div style="width: 37%;"></div></div></div></div></div></div></div></div></div><div></div><div></div></div><span aria-live="polite" aria-atomic="true" data-live-region=""></span></div>"`;

