exports[`Strategies DOM snapshots > at-admin-cap @ compact-5x7 1`] = `"<div><div><div data-panel-body=""><div data-panel-header=""><div><h3>Admin Building</h3></div><div><details data-panel-aside-expand="" open=""><summary aria-label="Panel status and controls"><span data-panel-aside-chevron="" aria-hidden="true"></span></summary><div data-panel-aside-full=""><div><span>2 active</span><span>·</span><span><span>450,000<span data-unit="f" title="funds"><span aria-hidden="true">f</span><span data-unit-word=""> funds</span></span></span></span></div></div></details></div></div><div><div data-section-full=""><div><div><div data-strategies-screen-inset=""><div><section aria-label="Active"><h4>Active</h4><article><div><div>Aggressive Negotiations</div><span>Operations</span></div><p>Push harder on every deal.</p><ul><li>-1.5% Funds Off on Launch Costs and R&amp;D Purchases.</li><li>-0.05% Funds Off on Facility Repair and Construction.</li></ul><div><span>factor <span>25 <span data-unit="%" title="percent"><span aria-hidden="true">%</span><span data-unit-word=""> percent</span></span></span></span><button type="button" aria-pressed="true" data-command-phase="idle" title="Deactivate this strategy">Deactivate</button></div></article><article><div><div>Open Source Tech</div><span>Research &amp; Development</span></div><p>Share technologies with research institutes in exchange for science.</p><ul><li>Converts 5% of Funds earned into Science points.</li></ul><div><span>factor <span>15 <span data-unit="%" title="percent"><span aria-hidden="true">%</span><span data-unit-word=""> percent</span></span></span></span><button type="button" aria-pressed="true" data-command-phase="idle" title="Deactivate this strategy">Deactivate</button></div></article></section><section aria-label="Available"><h4>Available</h4><article><div><div>Fundraising Campaign</div><span>Finances</span></div><p>Deactivate the running strategy first to enable this one.</p></article></section></div></div></div><div