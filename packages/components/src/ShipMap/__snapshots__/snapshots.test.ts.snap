exports[`Ship Map SVG snapshots > renders an empty parts list as a placeholder 1`] = `
"<svg width="200" height="200" role="img" aria-label="Ship diagram" style="display:block;flex:1;position:relative;z-index:1" xmlns="http://www.w3.org/2000/svg"><style><![CDATA[
:root {
  --color-text-primary: #ccc;
  --color-text-muted: #888;
  --color-text-dim: #858585;
  --color-text-inverse: #050505;
  --color-surface-raised: #1a1a1a;
  --color-border-strong: #333;
  --color-accent-fg: #00ff88;
  --color-focus: #00ff88;
  --color-go-text: #cfe;
  --color-warn-mark: #ff8c00;
  --color-nogo-mark: #ff4d4d;
  --color-go-mark: #3c8050;
  --color-neutral-mark: #858585;
  --color-info-mark: #7cf;
  --color-tag-yellow-fg: #ffeb3b;
  --color-tag-yellow-border: #6a5a2a;
  --color-tag-blue-bg: #0a0a1a;
  --color-tag-cyan-fg: #00cccc;
}
]]></style><rect width="200" height="200" fill="#050505" /><text x="100" y="100" text-anchor="middle" fill="var(--color-text-dim)" font-size="11">No vessel topology yet.</text></svg>"
`;

