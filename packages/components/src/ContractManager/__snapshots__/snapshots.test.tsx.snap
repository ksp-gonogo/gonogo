-accent-fg); font-variant-numeric: tabular-nums;"><span data-figure="">5.0<span data-unit="rep" data-tooltip="reputation"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="width: 1em; height: 1em;"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg><span data-unit-word=""> reputation</span></span></span></span></div></div><ul style="list-style: none; margin: var(--gap-sub-readout) 0 0; padding: 0px; display: flex; flex-direction: column; gap: var(--gap-related);"><li style="font-size: var(--font-size-compact); color: var(--color-text-primary);"><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span>Reach orbit around Kerbin</span></span><div style="color: var(--color-text-muted); font-size: var(--font-size-caption); white-space: pre-wrap;">Any inclination will do</div><ul style="list-style: none; padding: 0px; display: flex; flex-direction: column; gap: var(--gap-related); margin-left: 1.5ch;"><li style="font-size: var(--font-size-compact); color: var(--color-text-primary);"><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span>Be in a stable orbit</span></span></li></ul></li><li style="font-size: var(--font-size-compact); color: var(--color-text-primary);"><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span>Reach altitude between 70 km and 100 km</span></span></li><li style="font-size: var(--font-size-compact); color: var(--color-text-primary);"><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span>Return to Kerbin<span style="color: var(--color-text-faint); font-style: italic;"> (optional)</span></span></span></li></ul><div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: flex-end; gap: var(--gap-related); margin-top: auto; padding-top: var(--gap-actions);"><div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--gap-rewards); flex: 1 1 12ch; min-width: 0px;"><span style="font-size: var(--font-size-caption); letter-spacing: 0.1em; color: var(--color-text-faint);">CANCEL COSTS</span><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span style="font-size: var(--font-size-caption); letter-spacing: 0.1em; color: var(--color-text-faint);">FUNDS</span><span style="font-size: var(--font-size-value); font-weight: 600; color: var(--color-nogo-text); font-variant-numeric: tabular-nums;">−<span data-figure="">10,000<span data-unit="f" data-tooltip="funds"><span aria-hidden="true">f</span><span data-unit-word=""> funds</span></span></span></span></span><span style="display: flex; align-items: baseline; gap: var(--gap-related);"><span style="font-size: var(--font-size-caption); letter-spacing: 0.1em; color: var(--color-text-faint);">REP</span><span style="font-size: var(--font-size-value); font-weight: 600; color: var(--color-nogo-text); font-variant-numeric: tabular-nums;">−<span data-figure="">3.0<span data-unit="rep" data-tooltip="reputation"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true" style="width: 1em; height: 1em;"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21