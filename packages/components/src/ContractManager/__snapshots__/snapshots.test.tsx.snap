exports[`ContractManager DOM snapshots > multiple-active-contracts @ default-6x8 1`] = `"<div><div><div data-panel-body=""><div data-panel-sticky-top=""><div data-panel-rail-frame=""><span aria-live="polite" aria-atomic="false" data-live-region=""></span></div><div data-panel-header=""><div><h3>CONTRACT MANAGER</h3><span aria-hidden="true"><span></span></span></div></div></div><div><div><div style="font-size: var(--font-size-caption); letter-spacing: 0.06em; color: var(--color-text-muted); font-variant-numeric: tabular-nums;" role="status" aria-live="polite">3 active · 0 offered · 1 recent</div><div style="font-size: var(--font-size-caption); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-faint); margin-top: var(--gap-list-heading);">Active</div><div style="display: flex; flex-direction: column; gap: var(--gap-section);"><div><div><div>Build an orbital station around Kerbin</div><span style="color: var(--color-text-faint); font-size: var(--font-size-compact); font-variant-numeric: tabular-nums; flex-shrink: 0;">no deadline</span></div><div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--gap-related);"><div style="color: var(--color-text-muted); font-size: var(--font-size-caption); letter-spacing: 0.06em;">Kerbin Space Program</div></div><div style="display: flex; align-items: baseline; gap: var(--gap-related);"><span style="font-size: var(--font-size-caption); letter-spacing: 0.1em; color: var(--color-text-faint);">DIFFICULTY</span><span role="img" aria-label="Difficulty: 2 of 3" data-pips=""><span></span><span></span><span></span></span></div><div style="display: flex; flex-wrap: wrap; gap: var(--gap-rewards);"><div style="display: flex; align-items: baseline; gap: var(--gap-related);"><span style="font-size: var(--font-size-caption); letter-spacing: 0.1em; color: var(--color-text-faint);">FUNDS</span><span style="font-size: var(--font-size-value); font-weight: 600; color: var(--color-accent-fg); font-variant-numer