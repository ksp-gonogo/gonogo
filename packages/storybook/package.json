{
  "name": "@ksp-gonogo/storybook",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate-stories.ts",
    "storybook": "pnpm generate && storybook dev -p 6006",
    "build-storybook": "pnpm generate && storybook build -o dist/static",
    "smoke": "pnpm build-storybook && tsx scripts/smoke.ts",
    "review-sheet": "pnpm build-storybook && tsx scripts/review-sheet.ts",
    "typecheck": "pnpm generate && tsc --noEmit",
    "review-ledger": "tsx scripts/review-ledger.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ksp-gonogo/components": "workspace:*",
    "@ksp-gonogo/core": "workspace:*",
    "@ksp-gonogo/sitrep-sdk": "workspace:*",
    "@ksp-gonogo/ui-kit": "workspace:*",
    "@ksp-gonogo/uplink-tools": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "axe-core": "^4.10.2",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "storybook": "10.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
