{
  "name": "@ksp-gonogo/uplink-tools",
  "description": "The Uplink author's toolchain and its uplink-tools command: scaffolds, bundles and bakes an Uplink, renders its scenes in a real browser, generates its page, and supplies the app's own widgets as render hosts.",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksp-gonogo/gonogo.git",
    "directory": "packages/uplink-tools"
  },
  "homepage": "https://github.com/ksp-gonogo/gonogo/tree/main/packages/uplink-tools#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/widgets.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-probe": {
      "types": "./dist/render-probe.d.ts",
      "import": "./dist/render-probe.js"
    },
    "./page-check": {
      "types": "./dist/page-check.d.ts",
      "import": "./dist/page-check.js"
    },
    "./widget-facts": {
      "types": "./dist/widget-facts.d.ts",
      "import": "./dist/widget-facts.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./widgets.json": "./dist/widgets.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "uplink-tools": "./bin/uplink-tools.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/widget-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "peerDependencies": {
    "@ksp-gonogo/ui-kit": "*",
    "@testing-library/react": "^16.0.0",
    "esbuild": "^0.25.0 || ^0.28.0",
    "playwright": "^1.50.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "styled-components": "^6.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ksp-gonogo/ui-kit": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ksp-gonogo/components": "workspace:*",
    "@ksp-gonogo/sitrep-sdk": "workspace:*",
    "@ksp-gonogo/ui-kit": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "gifenc": "^1.0.3",
    "jsdom": "^29.0.2",
    "playwright": "^1.60.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
