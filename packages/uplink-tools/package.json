{
  "name": "@ksp-gonogo/uplink-tools",
  "description": "The Uplink docs toolchain: renders an Uplink's scenes in a real browser, generates its page, and supplies the app's own widgets as render hosts.",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksp-gonogo/gonogo.git",
    "directory": "packages/uplink-tools"
  },
  "homepage": "https://github.com/ksp-gonogo/gonogo/tree/main/packages/uplink-tools#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/widgets.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-probe": {
      "types": "./dist/render-probe.d.ts",
      "import": "./dist/render-probe.js"
    },
    "./page-check": {
      "types": "./dist/page-check.d.ts",
      "import": "./dist/page-check.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ksp-gonogo/ui-kit": "*",
    "esbuild": "^0.25.0 || ^0.28.0",
    "playwright": "^1.50.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@ksp-gonogo/components": "workspace:*",
    "@ksp-gonogo/sitrep-sdk": "workspace:*",
    "@ksp-gonogo/ui-kit": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "esbuild": "^0.28.0",
    "gifenc": "^1.0.3",
    "jsdom": "^29.0.2",
    "playwright": "^1.60.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
