{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // context.fonts.test reads the app's fonts.css for the weights it self-hosts.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/app/src/styles/fonts.css"
      ]
    }
  }
}
