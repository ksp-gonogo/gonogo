{
  "name": "@ksp-gonogo/ui-kit",
  "description": "Export-safe design system for Gonogo mission-control widgets and third-party Uplinks",
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksp-gonogo/gonogo.git",
    "directory": "packages/ui-kit"
  },
  "homepage": "https://github.com/ksp-gonogo/gonogo/tree/main/packages/ui-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./render-probe": {
      "types": "./dist/render-probe.d.ts",
      "import": "./dist/render-probe.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./page-check": {
      "types": "./dist/page-check.d.ts",
      "import": "./dist/page-check.js"
    }
  },
  "bin": {
    "gonogo-uplink": "./bin/gonogo-uplink.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp node_modules/@ksp-gonogo/theme/dist/tokens.css dist/tokens.css",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@ksp-gonogo/sitrep-sdk": "workspace:*",
    "@ksp-gonogo/theme": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "lucide-react": "^1.14.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "styled-components": "^6.0.0",
    "jest-axe": "^10.0.0",
    "esbuild": "^0.25.0 || ^0.28.0",
    "playwright": "^1.50.0",
    "@fontsource/jetbrains-mono": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "jest-axe": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "@fontsource/jetbrains-mono": {
      "optional": true
    }
  }
}
