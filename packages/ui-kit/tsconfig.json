{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    // The kit reaches itself by its own package name in a few places, so those
    // files stay CONSUMERS of it and share no code-split chunk with it (see
    // tsup.config.ts). These map that self-reference back to source for
    // typechecking, which is both more accurate than the emitted `.d.ts` and
    // free of a build-order dependency on this package's own `dist`.
    //
    // esbuild matches `external` against the import path as WRITTEN, before it
    // consults `paths`, so the bundler still leaves the specifier alone.
    "paths": {
      "@ksp-gonogo/ui-kit": ["./src/index.ts"],
      "@ksp-gonogo/ui-kit/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src"]
}
