import { describe, expect, it } from "vitest";
import { CONSTANT_DEBT } from "./one-home-modelling.debt";
import {
  type Finding,
  gradeAgainstDebt,
  lineOf,
  listSources,
  printReport,
  type SourceFile,
  scanRoot,
  stripComments,
} from "./one-home-modelling.scan";
import { ratchetRepoRoot } from "./ratchetBaseRef";

/**
 * One-home report 1: physical constants.
 *
 * Standard gravity, sea-level pressure, the gravitational constant and the two
 * gas constants may be written as numeric literals in one module each. This
 * lists every other literal.
 *
 * Homes: `STANDARD_GRAVITY` in `mod/sitrep-sdk/src/unit-system/definitions.ts`
 * is the only one of the five with a home today. A constant with no home lists
 * every occurrence, so the first module to write one down becomes the home by
 * being the one the report is told about.
 *
 * Scope: `packages/<pkg>/src` and `mod/sitrep-sdk/src`, TypeScript and TSX.
 * Tests, fixtures, generated code and test-support directories are skipped,
 * since a test may restate a figure it checks against. Comments are blanked
 * first, so prose that quotes a figure is not a literal.
 *
 * Report only: a finding never fails. The test fails as BLIND (a planted
 * literal the scan did not see) or when the scan read too little.
 */

interface ConstantSpec {
  readonly id: string;
  readonly name: string;
  readonly pattern: RegExp;
  /** Files allowed to carry the literal, or none when no home exists yet. */
  readonly homes: readonly string[];
}

const TEN_POW_MINUS_11 = String.raw`(?:e\s*-\s*0?11|\s*\*\s*10\s*\*\*\s*-\s*11|\s*\*\s*Math\.pow\(\s*10\s*,\s*-\s*11\s*\))`;

const CONSTANTS: readonly ConstantSpec[] = [
  {
    id: "g0",
    name: "standard gravity 9.80665",
    pattern: /(?<![\d.])9\.80665\d*(?![\d.])/g,
    homes: ["mod/sitrep-sdk/src/unit-system/definitions.ts"],
  },
  {
    id: "p0",
    name: "sea-level pressure 101.325 / 101325",
    pattern: /(?<![\d.])(?:101\.325\d*|101_?325(?:\.0+)?)(?![\d.])/g,
    homes: [],
  },
  {
    id: "G",
    name: "gravitational constant 6.674e-11",
    pattern: new RegExp(`(?<![\\d.])6\\.67\\d*${TEN_POW_MINUS_11}`, "gi"),
    homes: [],
  },
  {
    id: "R-air",
    name: "specific gas constant of air 287.05x",
    pattern: /(?<![\d.])287\.0\d*(?![\d.])/g,
    homes: [],
  },
  {
    id: "R-universal",
    name: "universal gas constant 8.314x",
    pattern: /(?<![\d.])(?:8\.314\d*|8314\.\d+)(?![\d.])/g,
    homes: [],
  },
];

function scanConstants(sources: readonly SourceFile[]): Finding[] {
  const out: Finding[] = [];
  for (const file of sources) {
    const code = stripComments(file.text);
    for (const spec of CONSTANTS) {
      if (spec.homes.includes(file.path)) continue;
      for (const m of code.matchAll(spec.pattern)) {
        out.push({
          key: `${file.path}#${spec.id}`,
          where: `${file.path}:${lineOf(code, m.index ?? 0)}`,
          detail: `${spec.name} as the literal ${m[0]}`,
        });
      }
    }
  }
  return out;
}

const sources = listSources(scanRoot(ratchetRepoRoot()));
const report = gradeAgainstDebt(
  "one-home constants",
  scanConstants(sources),
  CONSTANT_DEBT,
  sources.length,
);
printReport(report);

describe("one-home report: physical constants", () => {
  it("read a believable number of source files", () => {
    expect(sources.length).toBeGreaterThan(1000);
  });

  it("names every constant's home and the home still holds the literal", () => {
    const home = sources.find(
      (s) => s.path === "mod/sitrep-sdk/src/unit-system/definitions.ts",
    );
    expect(home?.text).toMatch(/STANDARD_GRAVITY\s*=\s*9\.80665/);
  });

  it("carries a reason on every debt entry", () => {
    expect(report.unexplained).toEqual([]);
  });

  it("is not BLIND: sees a planted literal of each constant outside its home", () => {
    const planted: SourceFile = {
      path: "packages/planted/src/model.ts",
      text: [
        "export const a = 9.80665;",
        "export const b = 101.325;",
        "export const c = 101325;",
        "export const d = 6.674e-11;",
        "export const e = 6.6743 * 10 ** -11;",
        "export const f = 287.058;",
        "export const g = 8.314462;",
      ].join("\n"),
    };
    const found = scanConstants([planted]);
    expect(found.map((f) => f.detail)).toHaveLength(7);
  });

  it("does not count a figure quoted in a comment", () => {
    const quoted: SourceFile = {
      path: "packages/planted/src/quote.ts",
      text: "/** g0 is 9.80665 m/s2 */\n// 101.325 kPa\nexport const x = 1;",
    };
    expect(scanConstants([quoted])).toEqual([]);
  });
});
