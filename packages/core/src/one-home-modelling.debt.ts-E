import type { Debt } from "./one-home-modelling.scan";

/**
 * Debt lists for the three one-home reports: what the tree contained when each
 * report was written. An entry is a finding the report already knows, each with
 * the reason it stands. Anything the report prints as NEW is not on these lists.
 * An entry whose finding is gone prints as GONE and can be deleted.
 */

/** Key: `<file>#<constant id>`. */
export const CONSTANT_DEBT: Debt = {
  "mod/sitrep-sdk/src/api/stock-bodies.ts#p0":
    "Kerbin's surfacePressure in the stock body table, 1 atm in Pa. A body datum in a data table, not a model constant, and sea-level pressure has no shared home yet",
};

/** Key: the producer's file. */
export const TOPIC_VALUE_DEBT: Debt = {
  "mod/sitrep-sdk/src/testing/stream-fixture.tsx":
    "Published test helper that takes partial payloads per Topic so a test states only the fields it cares about; loose by design, not shipped to a running app",
  "mod/sitrep-sdk/src/testing/stub-transport.ts":
    "Published test transport that frames caller-supplied partial payloads and casts them into stream-data; loose by design for tests, not a running-app producer",
  "packages/logger/src/AxiomTransport.ts":
    "False positive: its ingest is the Axiom log dataset call, not the telemetry store",
  "packages/sitrep-client/src/stub-transport.ts":
    "Re-export of the sdk's StubTransport; builds no value itself, and the sdk copy is listed above",
  "packages/app/src/telemetry/AugmentAvailabilityFeeder.tsx":
    "False positive of the Feeder path signal: it feeds a ui-kit availability store from telemetry reads and builds no Topic value",
};

/** Key: the module's file. */
export const FLIGHT_MATHS_DEBT: Debt = {
  "mod/sitrep-sdk/src/api/stock-bodies.ts":
    "Carries the sea-level pressure literal in a static body table; data, not maths",
  "mod/sitrep-sdk/src/frame-qualifier.ts":
    "apsidesExist is a predicate on whether a frame makes apsides meaningful; it computes no orbit",
  "packages/core/src/orbital.ts":
    "The app's own helpers (circular and escape speed from a body's gm, period, pressure at altitude, anomaly to radius) beside the sdk's orbit code; core is not one of the shared homes",
  "packages/components/src/AtmosphereProfile/index.tsx":
    "Its own pressureAt over the body's pressure table for the observed and modelled altitude; atmosphere pressure has no shared home",
  "packages/components/src/FuelStatus/deltaV.ts":
    "Picks and maxes the stage Δv the mod reports (pickDeltaV, maxStageDeltaV); selection over contract values, no Δv is computed",
  "packages/components/src/KeplerPeriod/index.tsx":
    "Computes the period from sma and mu inline, a second copy of the sdk's orbit period",
  "packages/components/src/LandingStatus/solveLanding.ts":
    "Its own suicide-burn solve (rocketEquationBurn) with the rocket equation inline; the sdk has no landing maths",
  "packages/components/src/ManeuverPlanner/burnWindow.ts":
    "Burn duration from the two instants the wire ships; subtraction, not rocket maths",
  "packages/components/src/ManeuverPlanner/planning.ts":
    "Burn true anomaly and mean motion computed inline from mu, beside the sdk's Kepler code",
  "packages/components/src/ManeuverPlanner/transferPlan.ts":
    "Transfer period from sma and mu inline, a second copy of the sdk's orbit period",
  "packages/components/src/Rendezvous/geometry/encounter.ts":
    "Its own true anomaly at a time and mean motion from mu, beside the sdk's Kepler code",
  "packages/components/src/Rendezvous/geometry/kepler.ts":
    "A full second Kepler module (solveKepler, orbitalPeriod, mean motion, speed) next to mod/sitrep-sdk/src/spine/kepler.ts",
  "packages/components/src/TrackingStation/systemEntities.ts":
    "trueAnomalyOf advances an anomaly to the instant on screen; a second anomaly conversion outside the sdk",
  "packages/components/src/TransferWindow/transferData.ts":
    "celestialToOrbitElements builds sdk-shaped elements from the body catalogue; unit conversion, not a second solver",
};
