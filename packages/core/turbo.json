{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // core's OWN tests, keyed on core's own sources like every other package.
    // The cross-package ratchets moved to `test:scans` below; keying this whole
    // task on the repo re-ran all 134 files (85.7s) on any change anywhere, on
    // every push, and grew a 17 GB turbo cache doing it.
    "test": {
      "dependsOn": ["^build"]
    },
    // The cross-package ratchets: the styleguide-* family, uplink-boundary,
    // vendor-name, fixture-gated-suites and the rest. They scan EVERY tracked
    // file (`git grep -- packages mod`), so their result depends on sources
    // turbo's per-package cache cannot see. A stale pass here is a guard that
    // silently stopped guarding, which has happened THREE times, so the key
    // stays deliberately broad.
    //
    // The key is the whole tracked tree. Between them the scans read every
    // package.json and tsconfig, packages/*/scripts, the root configs,
    // scripts/, tests/, docs/, .github/ and asyncapi.yaml, so a key narrower
    // than the tree replays a pass when only one of those changed. Ignored
    // build output and local state stay out, except local_docs, whose
    // recordings the fixture-gated scans read. turbo-input-coverage.test.ts
    // fails on a tracked file missing from `inputs` and on an ignored one in it.
    //
    // WHICH tests these are is DERIVED, not listed: packages/core/scan-tests.mjs
    // detects a test that reaches outside the package. A hand-list is what lost
    // entries the three times above.
    "test:scans": {
      "dependsOn": ["^build"],
      // The ratchets read their base revision from this. Turbo passes NOTHING
      // it is not told about, so without this line the tests never saw it and
      // silently fell back to `origin/staging`. That fallback is a valid
      // ancestor locally, so it PASSED on a developer machine, and on a staging
      // push `origin/staging` IS the commit under test, so every shrink-only
      // ratchet refused and the job was red. Declared as `env` rather than
      // `passThroughEnv` on purpose: a different base is a different result, so
      // it must take part in the cache key.
      "env": ["RATCHET_BASE_REF", "GITHUB_ACTIONS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*",
        "!$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/.launch.sh",
        "!$TURBO_ROOT$/.startup-prompt",
        "!$TURBO_ROOT$/.agent.log",
        "!$TURBO_ROOT$/.DS_Store",
        "!$TURBO_ROOT$/asyncapi.yaml.actual",
        "!$TURBO_ROOT$/*.tgz",
        "$TURBO_ROOT$/.githooks/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.serena/**",
        "$TURBO_ROOT$/.vscode/**",
        "$TURBO_ROOT$/docker/**",
        "$TURBO_ROOT$/docs/**",
        "!$TURBO_ROOT$/docs/superpowers/**",
        "$TURBO_ROOT$/local_docs/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/test/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/packages/*/coverage/**",
        "!$TURBO_ROOT$/mod/*/client/coverage/**",
        "!$TURBO_ROOT$/mod/*/coverage/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/renders/**",
        "!$TURBO_ROOT$/**/.DS_Store",
        "!$TURBO_ROOT$/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/**/tsup.config.bundled_*.mjs",
        "!$TURBO_ROOT$/packages/app/public/uplinks/**",
        "!$TURBO_ROOT$/mod/**/bin/Debug/**",
        "!$TURBO_ROOT$/mod/**/bin/Release/**",
        "!$TURBO_ROOT$/mod/**/obj/**"
      ]
    }
  }
}
