{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // core's OWN tests, keyed on core's own sources like every other package.
    // The cross-package ratchets moved to `test:scans` below; keying this whole
    // task on the repo re-ran all 134 files (85.7s) on any change anywhere, on
    // every push, and grew a 17 GB turbo cache doing it.
    "test": {
      "dependsOn": ["^build"]
    },
    // The cross-package ratchets: the styleguide-* family, uplink-boundary,
    // vendor-name, fixture-gated-suites and the rest. They scan EVERY tracked
    // file (`git grep -- packages mod`), so their result depends on sources
    // turbo's per-package cache cannot see. A stale pass here is a guard that
    // silently stopped guarding, which has happened THREE times, so the key
    // stays deliberately broad.
    //
    // The key is the SCAN, not the source layout. Keying on `**/src/**` said
    // "TypeScript laid out the way TypeScript is laid out" and could not see
    // C#: no `src/` segment exists in a C# project path, and three Earth-day
    // constants in mod/*.cs replayed a cached pass locally while CI ran cold
    // and failed. Match the scan's own shape; exclude only build output, which
    // is gitignored and so never read by `git grep`.
    //
    // WHICH tests these are is DERIVED, not listed: packages/core/scan-tests.mjs
    // detects a test that reaches outside the package. A hand-list is what lost
    // entries the three times above.
    "test:scans": {
      "dependsOn": ["^build"],
      // The ratchets read their base revision from this. Turbo passes NOTHING
      // it is not told about, so without this line the tests never saw it and
      // silently fell back to `origin/staging`. That fallback is a valid
      // ancestor locally, so it PASSED on a developer machine, and on a staging
      // push `origin/staging` IS the commit under test, so every shrink-only
      // ratchet refused and the job was red. Declared as `env` rather than
      // `passThroughEnv` on purpose: a different base is a different result, so
      // it must take part in the cache key.
      "env": ["RATCHET_BASE_REF", "GITHUB_ACTIONS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/mod/**/bin/**",
        "!$TURBO_ROOT$/mod/**/obj/**",
        "!$TURBO_ROOT$/mod/**/dist/**",
        "!$TURBO_ROOT$/mod/**/node_modules/**"
      ]
    }
  }
}
