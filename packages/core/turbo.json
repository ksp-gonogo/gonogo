{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      // core#test carries the cross-package design-system guard
      // (src/styleguide.test.ts scans EVERY package's src for raw hex). That
      // scan reads sibling files off disk, which turbo's per-package cache
      // can't see, so a hex added in another package used to replay a stale
      // core#test pass, the reason the pre-push hook needed --force. Keying
      // core#test's cache on the workspace src trees makes a normal cached
      // `turbo run test` re-run it on any src change, so --force is gone.
      // Broad glob (not the exact SCAN_ROOTS list) so a newly added
      // package/scan-root can't silently drop out of the key. The mod/ uplink
      // client + sdk src trees are keyed too: they were missed originally, so
      // an em-dash / raw z-index in mod/*/client/src replayed a stale core#test
      // pass until an unrelated packages/*/src change happened to bust the key.
      //
      // The key is the SCAN, not the source layout. Those guards run
      // `git grep -- packages mod`, so their subject is every TRACKED file
      // under either root, whatever its extension or path shape. Keying on
      // `**/src/**` said "TypeScript laid out the way TypeScript is laid out"
      // and so could not see C#: no `src/` segment exists in a C# project
      // path, and three Earth-day constants in mod/*.cs replayed a cached pass
      // locally while CI ran cold and failed. That is the same hole a third
      // time, so match the scan's own shape instead of guessing at it, and
      // exclude only build output (gitignored, so `git grep` never reads it).
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/mod/**/bin/**",
        "!$TURBO_ROOT$/mod/**/obj/**",
        "!$TURBO_ROOT$/mod/**/dist/**",
        "!$TURBO_ROOT$/mod/**/node_modules/**"
      ]
    }
  }
}
