# Workspace deps are copied into each consuming package's node_modules
# (rather than symlinked) so `pnpm deploy` can produce a self-contained
# /app directory for Docker images. Symlinks would point outside the
# image build context and break at runtime.
inject-workspace-packages=true

# @ksp-gonogo/kerbcast + @ksp-gonogo/kerbcast-react (the kerbcast protocol
# bindings, consumed by @ksp-gonogo/gonogo-kerbcast-uplink) resolve from public npm,
# no scoped registry routing or auth needed.

# A --filter that matches no package prints a notice and exits 0, so a renamed
# or mistyped package id turns every gate invoked that way into a green step
# that ran nothing. CI reaches the visual gate, the unfed-snapshot gate, the
# probe-render smoke check and every per-Uplink build/test/typecheck/docs leg
# through --filter, so the whole of uplink.yml can pass having done no work.
fail-if-no-match=true
