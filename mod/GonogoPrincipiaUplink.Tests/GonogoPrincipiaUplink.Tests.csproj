<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Every file of this uplink EXCEPT the one that reaches the game compiles
       here, which is the point of it. The guard needs only System.Reflection;
       the observation, the builder and the reflection walk need nothing but the
       framework; the uplink needs Sitrep.Contract for ISitrepUplink.

       PrincipiaUplink.Observer.cs and FlightPlannerHook.cs are deliberately
       ABSENT. They are the only files naming a KSP or Harmony type, and
       PrincipiaUplink is partial precisely so that omitting them still compiles:
       the AttachObserver partial method call disappears and the publish rule is
       driven by a fake observer instead. Adding either file here would trade that
       coverage for a reference this project does not need.

       Selective Compile, the pattern the sibling uplink Tests projects use. -->
  <ItemGroup>
    <Compile Include="..\GonogoPrincipiaUplink\PrincipiaVersionGuard.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\PrincipiaUplink.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\IFlightPlanObserver.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\FlightPlanObservation.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\FlightPlanBuilder.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\ReflectedMembers.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\FlightPlanReflection.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\IProvenanceSource.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\ProvenanceObservation.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\ProvenanceReflection.cs" />
    <Compile Include="..\GonogoPrincipiaUplink\ProvenanceBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj" />
  </ItemGroup>

</Project>
