{
  "name": "@ksp-gonogo/sitrep-sdk",
  "description": "Author-facing SDK for Gonogo (Sitrep) KSP Uplinks: the generated wire contract plus the curated framework/data/hook surface",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./frames": "./src/frames/index.ts",
    "./media": "./src/media/index.ts",
    "./registry": "./src/registry/index.ts",
    "./spine": "./src/spine/index.ts",
    "./testing": "./src/testing/index.ts",
    "./biome": "./biome.shared.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksp-gonogo/gonogo.git",
    "directory": "mod/sitrep-sdk"
  },
  "homepage": "https://github.com/ksp-gonogo/gonogo/tree/main/mod/sitrep-sdk#readme",
  "files": [
    "biome.shared.json",
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./frames": {
        "types": "./dist/frames/index.d.ts",
        "import": "./dist/frames/index.js"
      },
      "./media": {
        "types": "./dist/media/index.d.ts",
        "import": "./dist/media/index.js"
      },
      "./registry": {
        "types": "./dist/registry/index.d.ts",
        "import": "./dist/registry/index.js"
      },
      "./spine": {
        "types": "./dist/spine/index.d.ts",
        "import": "./dist/spine/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/gen-version.mjs SDK_VERSION && tsc -p tsconfig.json && node scripts/bundle-delay-worker.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test-d.json"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "^18 || ^19",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ksp-gonogo/logger": "workspace:*",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.28",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0"
  }
}
