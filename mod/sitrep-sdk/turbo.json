{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The *-cs-sync and topic tests walk mod/ for the C# declarations they
    // mirror, and binary-frame reads a golden fixture from mod/golden-fixtures.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mod/**",
        "!$TURBO_ROOT$/mod/**/bin/Debug/**",
        "!$TURBO_ROOT$/mod/**/bin/Release/**",
        "!$TURBO_ROOT$/mod/**/obj/**",
        "!$TURBO_ROOT$/mod/**/dist/**",
        "!$TURBO_ROOT$/mod/**/.turbo/**",
        "!$TURBO_ROOT$/mod/**/node_modules/**",
        "!$TURBO_ROOT$/mod/**/coverage/**"
      ]
    }
  }
}
