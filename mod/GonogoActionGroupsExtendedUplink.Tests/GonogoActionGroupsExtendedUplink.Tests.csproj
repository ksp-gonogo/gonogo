<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Compile the uplink's own files directly (same selective-Compile
       pattern GonogoRealAntennasUplink.Tests / GonogoKerbcastUplink.Tests /
       GonogoScansatUplink.Tests / GonogoKosUplink.Tests all use, none of
       them ProjectReference their net48 main csproj from a net10.0 test
       project, to avoid the cross-TFM NU1702 resolution warning). The whole
       uplink is KSP-free (no KSP/Unity reference at all; see the main
       csproj's header), so unlike RA/kerbcast there is no split: every file
       in the main project compiles headlessly. -->
  <ItemGroup>
    <Compile Include="..\GonogoActionGroupsExtendedUplink\IAgxApi.cs" />
    <Compile Include="..\GonogoActionGroupsExtendedUplink\AgxReflection.cs" />
    <Compile Include="..\GonogoActionGroupsExtendedUplink\AgxActionGroupsBackend.cs" />
    <Compile Include="..\GonogoActionGroupsExtendedUplink\ActionGroupsExtendedUplink.cs" />
  </ItemGroup>

  <!--
    Sitrep.Contract, and nothing else of this repo's: the same one-line compile
    surface the Uplink itself has, which is what makes this suite travel with the
    Uplink instead of being left behind by it.

    It used to reference Sitrep.Host (for ChannelEngine/UplinkDiscovery and the
    ActionGroups election helper) and Sitrep.Contract.TestSupport (for
    StarvationProbeHost), dragging Sitrep.Core, Sitrep.Transport and
    Sitrep.Propagation along transitively without naming any of them. All three
    needs are gone rather than excused: the capability id moved to
    Sitrep.Contract (ActionGroupsCapability), the engine-ordering cases moved to
    Sitrep.Host.Tests where the engine may be named, and the host double is
    RecordingUplinkHost.cs here, per docs/uplink-isolation.md "Testing a NEW
    Uplink".
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj" />
  </ItemGroup>

</Project>
