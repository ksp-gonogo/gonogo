<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sitrep.LoadProbe</RootNamespace>
    <AssemblyName>Sitrep.LoadProbe</AssemblyName>
  </PropertyGroup>
  <!-- A deploy-time console tool, NOT part of the shipped mod: it never reaches
       GameData and nothing in Sitrep.Host references it. It targets net10.0
       because AssemblyLoadContext is what lets it load a KSP plugin and its
       dependencies from chosen directories without the game running.
       scripts/gonogo_claude_tools.sh runs it before a deploy copies anything. -->
</Project>
