<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GonogoFerramAerospaceResearchUplink's OWN contract slice: the aero.* wire
    payload and the two unit tokens it introduces. No Uplink-specific wire type
    lives in core, so this project exists for the same reason every other
    Uplink's does.

    MIT, and it can be: unlike the plugin beside it (which reaches every FAR
    member by reflection and never links FerramAerospaceResearch.dll), this
    slice declares plain DTOs against Sitrep.Contract with no FAR code or types
    in it at all. A third party could write an alternative client against this
    wire shape without touching FAR's licence.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>GonogoFerramAerospaceResearchUplink.Contract</AssemblyName>
    <RootNamespace>GonogoFerramAerospaceResearchUplink</RootNamespace>
  </PropertyGroup>

  <!-- Sitrep.Contract only, Private="false": the attributes and the core unit
       catalog are provided by the core mod at runtime, never copied here. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
