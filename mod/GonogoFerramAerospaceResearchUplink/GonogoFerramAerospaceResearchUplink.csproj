<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). Ferram Aerospace Research
       ships a LICENSE file that is not machine-classifiable, and the mod is
       widely understood to be copyleft-family, so its obligations could reach a
       COMBINED work. This uplink therefore NEVER links
       FerramAerospaceResearch.dll and NEVER derives from its types: it reaches
       every FAR member by runtime reflection (AeroReflection), the same
       arm's-length pattern gonogo uses for every third-party-mod uplink. That
       boundary is what keeps this assembly clear of any ShareAlike obligation.
       FAR's attribution notice is retained in NOTICE-FAR.txt alongside this
       file. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoFerramAerospaceResearchUplink</AssemblyName>
    <RootNamespace>GonogoFerramAerospaceResearchUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: Private="false" (reference-only, never
       copied to the output). Only FlightGlobals is reached from them, in the
       uplink class; the reflection layer names no KSP type at all, which is what
       lets the whole read walk run headless in this Uplink's tests. FAR is NOT
       referenced, by design. -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract ONLY (Private="false"): the arm's-length compile surface
       a third-party uplink needs. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- GonogoFerramAerospaceResearchUplink.Contract: this Uplink's OWN wire type
       (AeroState). Private defaults to true (unlike the Sitrep.Contract
       reference above): core does not provide this DLL at runtime, it is this
       Uplink's own contract slice and bundles into its GameData output. -->
  <ItemGroup>
    <ProjectReference Include="..\GonogoFerramAerospaceResearchUplink.Contract\GonogoFerramAerospaceResearchUplink.Contract.csproj" />
  </ItemGroup>

</Project>
