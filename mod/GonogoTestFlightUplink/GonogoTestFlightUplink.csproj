<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). TestFlight is
       reached ENTIRELY by runtime reflection (TestFlightReflection) - this
       assembly NEVER links TestFlightCore.dll / TestFlightAPI.dll and NEVER
       derives from their types, the same arm's-length reflection pattern the
       other reflection-only uplinks use. TestFlight's attribution notice is retained in
       NOTICE-TestFlight.txt alongside this file. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoTestFlightUplink</AssemblyName>
    <RootNamespace>GonogoTestFlightUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KspManaged: root for the portable KSP/Unity reference DLLs. Defaults to
       the repo's local dev copy so a plain `dotnet build` with no /p: override
       keeps working; a fresh worktree (gitignored local_docs absent) passes
       /p:KspManaged=<the KSP reference-assembly directory>. -->
  <PropertyGroup>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies - same portable copy + Private="false"
       pattern as the other KSP-referencing uplinks. Only the TestFlight
       assemblies are forbidden as a compile-time reference (reached by
       reflection instead). -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract ONLY (Private="false") - the arm's-length compile
       surface a third-party uplink needs. NO reference to any TestFlight
       assembly, by design. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
