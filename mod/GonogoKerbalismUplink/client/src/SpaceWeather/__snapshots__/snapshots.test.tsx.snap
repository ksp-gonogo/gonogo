"50" r="3" fill="var(--color-status-nogo-bg)" stroke="var(--color-text-primary)" stroke-width="0.6"></circle></svg></div><div style="display: flex; flex-direction: column; min-width: 0px; min-height: 0px;"><div style="font-size: 23px; font-weight: 700; line-height: 1.05; color: var(--color-status-nogo-bg); font-variant-numeric: tabular-nums; white-space: nowrap; flex: 0 0 auto;">10.38 rad/h</div><div style="font-size: var(--font-size-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">habitat dose rate</div></div></div></div><div data-section-full=""><div style="flex: 0 0 auto; display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-10); min-height: 0px;"><span style="display: block; margin-top: var(--space-8);">Solar-wind flux</span><div style="flex: 0 0 auto; height: 44px; width: 100%;"><svg viewBox="0 0 100 30" preserveAspectRatio="none" width="100%" height="100%" role="img" aria-label="Solar-wind and radiation-field flux"><path d="M 0 16.50 L 0.00 17.36 L 1.59 13.74 L 3.17 13.59 L 4.76 21.35 L 6.35 15.77 L 7.94 19.89 L 9.52 14.86 L 11.11 5.43 L 12.70 19.70 L 14.29 8.10 L 15.87 9.35 L 17.46 29.00 L 19.05 13.92 L 20.63 28.38 L 22.22 13.44 L 23.81 1.00 L 25.40 1.00 L 26.98 11.23 L 28.57 1.00 L 30.16 29.00 L 31.75 18.67 L 33.33 6.86 L 34.92 10.91 L 36.51 21.11 L 38.10 10.79 L 39.68 17.61 L 41.27 27.44 L 42.86 27.72 L 44.44 29.00 L 46.03 8.79 L 47.62 1.00 L 49.21 12.85 L 50.79 14.38 L 52.38 25.66 L 53.97 9.20 L 55.56 15.51 L 57.14 13.19 L 58.73 1.77 L 60.32 13.80 L 61.90 16.49 L 63.49 29.00 L 65.08 8.43 L 66.67 29.00 L 68.25 22.57 L 69.84 1.00 L 71.43 29.00 L 73.02 1.00 L 74.60 7.12 L 76.19 25.53 L 77.78 7.55 L 79.37 18.34 L 80.95 29.00 L 82.54 16.93 L 84.13 19.63 L 85.71 19.40 L 87.30 26.34 L 88.89 29.00 L 90.48 28.37 L 92.06 20.70 L 93.65 4.88 L 95.24 26.71 L 96.83 29.00 L 98.41 24.75 L 100.00 1.00 L 100 30 L 0 30 Z" fill="var(--color-status-nogo-bg)" opacity="0.16"></path><path d="M 0 16.50 L 0.00 17