<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). Kerbalism is Unlicense
       (public domain) but this uplink takes the same arm's-length stance as
       GonogoRealAntennasUplink regardless: it NEVER links Kerbalism's assembly
       and NEVER derives from its types: every Kerbalism member is reached by
       runtime reflection (KerbalismReflection), so the uplink stays clean of
       any dependency-licence surprise and loads presence-safe when Kerbalism
       is absent. Kerbalism's attribution is retained in NOTICE-Kerbalism.txt. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoKerbalismUplink</AssemblyName>
    <RootNamespace>Gonogo.KerbalismUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KspManaged: root for the portable KSP/Unity reference DLLs (below).
       Defaults to the repo's local dev copy so a plain `dotnet build` with no
       /p: overrides keeps working; CI passes /p:KspManaged=... instead. Same
       pattern as GonogoRealAntennasUplink. -->
  <PropertyGroup>
    <!-- KspGameData: root of an installed GameData tree, for 0Harmony.dll below (that reference
         DLL lives in an installed mod's own GameData folder, not the portable KspManaged set) -
         same property GonogoKosUplink.csproj / Gonogo.KSP.csproj already use for the identical
         Harmony reference. -->
    <KspGameData Condition="'$(KspGameData)' == ''">$(MSBuildThisFileDirectory)..\..\local_docs\syncthing\kspdata\GameData</KspGameData>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: Private="false", satisfied by KSP at
       runtime. Kerbalism itself is NEVER referenced (reached by reflection). -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Harmony (0Harmony.dll), used ONLY by KerbalismScienceHook.cs's presence-gated postfix on
       KERBALISM.SubjectData.RetrieveScience. Private="false": KSP's own 000_Harmony/0Harmony.dll
       satisfies the load at runtime; referenced here from the installed copy, same as
       GonogoKosUplink's own observe-only postfix. -->
  <ItemGroup>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract (Private="false"): the arm's-length compile surface.
       NO reference to Kerbalism.dll, by design. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Gonogo.KSP (Private="false"): the bundled core addon. This Uplink calls its
       Gonogo.KSP.CurrencyDelay.DelayedScienceSink to hand delayed science increments to the
       currency-delay subsystem, which owns the aggregator/ledger/light-time. Never copied to
       output; gonogo-core provides Gonogo.dll at runtime.

       Sitrep.Host, Sitrep.Core, Sitrep.Transport and Sitrep.Propagation are named
       below for ONE reason: Gonogo.KSP drags all four in, and <Private>false</Private>
       on an outer ProjectReference does not suppress copying of that project's own
       transitive references, so a reachable project not named here is copied into
       this Uplink's output. All four were, until this list existed. Nothing here
       imports a type from Sitrep.Core, Sitrep.Transport or Sitrep.Propagation, and
       that is not a reason to drop them: removing them for tidiness re-opens the
       copying. Core Gonogo provides every one of them at runtime.

       All five lines go when the Gonogo.KSP reference does. -->
  <ItemGroup>
    <ProjectReference Include="..\Gonogo.KSP\Gonogo.KSP.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sitrep.Host\Sitrep.Host.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sitrep.Core\Sitrep.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sitrep.Transport\Sitrep.Transport.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Sitrep.Propagation\Sitrep.Propagation.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- GonogoKerbalismUplink.Contract: this Uplink's OWN wire types (the five
       kerbalism.* Topic payloads and their ten nested shapes), relocated out
       of Sitrep.Contract (see that project's own header comment). Private
       defaults to true (unlike the Sitrep.Contract reference above): this DLL
       is NOT provided by core at runtime, it is this Uplink's own contract
       slice, so it bundles into GonogoKerbalismUplink's own GameData output
       same as any other Uplink-owned assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\GonogoKerbalismUplink.Contract\GonogoKerbalismUplink.Contract.csproj" />
  </ItemGroup>

</Project>
