  "resources": {
    "homepage": "https://github.com/ksp-gonogo/gonogo"
  },
  "tags": [
    "plugin",
    "telemetry",
    "principia"
  ],
  "depends": [
    { "name": "GonogoCore" },
    { "name": "Harmony2" }
  ],
  "recommends": [
    { "name": "Principia" }
  ],
  "install": [
    {
      "file": "GameData/GonogoPrincipiaUplink",
      "install_to": "GameData"
    }
  ]
}
