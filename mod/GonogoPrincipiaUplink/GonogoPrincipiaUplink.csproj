<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md).

       This assembly NEVER references any Principia assembly. It DOES now bind
       Principia members by reflection, which the earlier detection-only version
       did not, and the distinction that makes it safe is worth stating: every
       member it reads is managed, and each one was read in the decompiled body
       and confirmed to touch no plugin. Principia's native surface aborts the KSP
       process on a bad call, but that guard is armed against the ARGUMENTS a
       caller passes it, and a field read passes none. The one property on the
       burn editor that does cross the ABI is named and excluded in
       ReflectedMembers' doc comment. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoPrincipiaUplink</AssemblyName>
    <RootNamespace>GonogoPrincipiaUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP + Harmony, and the reason is recorded rather than the references left
       to look speculative. It is this:

       - Debug, because a warning written to Console.Error from inside the host is
         invisible in the game's log.
       - 0Harmony, for AccessTools.TypeByName ONLY. This Uplink patches nothing.
         It used to: two observe-only postfixes on the producer's planner render
         fed a channel that mirrored that window, and they went with it, because a
         channel that answers only while the player has a panel open is not a
         channel. Nothing here may add a patch back without a better reason than
         that one turned out to be.

       The property worth preserving is that the PURE half stays reference-free:
       the observation types, the readers and the builders touch no KSP or Harmony
       type, so the payload logic and the reflection walks are tested headless.
       Keep it that way: logic that migrates into a game-facing file stops being
       testable. -->
  <PropertyGroup>
    <!-- KspGameData: root of an installed GameData tree, for 0Harmony.dll (that
         reference DLL lives in an installed mod's own folder, not the portable
         KspManaged set). Same property the Kerbalism/kOS uplinks use for the
         identical Harmony reference. -->
    <KspGameData Condition="'$(KspGameData)' == ''">$(MSBuildThisFileDirectory)..\..\local_docs\syncthing\kspdata\GameData</KspGameData>
    <!--
      A git worktree has no local_docs of its own (it is gitignored), so the
      path above resolves into nothing there and this project cannot find the
      mod assemblies the main checkout plainly holds. GONOGO_DATA_ROOT names
      the checkout that has them, the same variable mod/Directory.Build.props
      already reads for KspManaged.
    -->
    <KspGameData Condition="!Exists('$(KspGameData)') And '$(GONOGO_DATA_ROOT)' != ''">$(GONOGO_DATA_ROOT)\local_docs\syncthing\kspdata\GameData</KspGameData>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The arm's-length compile surface a third-party uplink needs, plus this
       Uplink's own contract slice for the flight-plan payload. NO reference to
       any Principia assembly, by design: every Principia member is reached by
       reflection.

       The two references differ in Private, and the difference is what gets
       deployed. Sitrep.Contract is provided at runtime by gonogo-core's own
       Plugins folder, so Private="false" keeps it out of this project's output.
       GonogoPrincipiaUplink.Contract is the opposite case: it holds THIS
       Uplink's wire payloads (PrincipiaPlan, PrincipiaSettings, the analysis
       shapes and the args types), nothing else in the mod ships it,
       and PlanReader / PrincipiaFrame / PrincipiaSession bind those types at
       compile time. Marked Private="false" it never reached bin/Release, so
       there was nothing for a deploy to copy and KSP would have dropped the
       whole Uplink on a failed assembly resolve. It takes the default, the same
       as every sibling Uplink's own contract slice. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\GonogoPrincipiaUplink.Contract\GonogoPrincipiaUplink.Contract.csproj" />
  </ItemGroup>

</Project>
