<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). Action Groups Extended
       (AGX, linuxgurugamer/AGExt) is GPL3, a CODE copyleft that could reach a
       COMBINED work. This uplink therefore NEVER links AGExt's assembly and
       NEVER derives from its types: every AGExt member is reached by runtime
       reflection (AgxReflection), the same arm's-length pattern
       GonogoRealAntennasUplink uses against RealAntennas' CC-BY-SA-4.0
       assembly and GonogoKerbcastUplink uses against kerbcast's
       CC-BY-NC-SA-4.0 assembly. We USE the running mod's public API, we don't
       INCORPORATE its code. AGExt's attribution notice is retained in
       NOTICE-AGEXT.txt alongside this file.

       Unlike RA/kerbcast, this project takes NO KSP/Unity reference at all:
       every AGExt method we call (AGXListOfAssignedGroups/AGXGroupState/
       AGXActivateGroup) is an active-vessel form that scopes to
       FlightGlobals.ActiveVessel internally, so this assembly never touches
       stock KSP itself.

       Compile surface: Sitrep.Contract alone (Private="false", see below).
       IActionGroupsBackend, the seam this uplink implements, sits there
       beside comms' ICommsBackend. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoActionGroupsExtendedUplink</AssemblyName>
    <RootNamespace>Gonogo.ActionGroupsExtendedUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Sitrep.Contract, and nothing else of this repo's: the whole compile surface,
    which is what the Uplink isolation rule requires and what makes this project
    buildable by someone who only has what is published. Private=false because
    core Gonogo already ships Sitrep.Contract.dll in GameData/Gonogo/Plugins and
    KSP loads every GameData plugin into one AppDomain, so this uplink resolves
    those types from core's copy at runtime and must not bundle a second one.

    Sitrep.Host was here for IActionGroupsBackend and ActionGroupsElection. The
    interface moved to Sitrep.Contract, where the comms seam it mirrors already
    lived, and the election helper is core's own registration side that this
    uplink never needed: it names the capability id directly, as the comms
    backends do. Sitrep.Core, Sitrep.Transport and Sitrep.Propagation went with
    it, having only ever been listed to stop Sitrep.Host copying them into this
    uplink's output.

    NOTE: no reference to AGExt.dll, by design (see the licence header above),
    and NO KSP/Unity reference either (see above: this uplink never touches
    stock KSP directly).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj" Private="false" />
  </ItemGroup>

</Project>
