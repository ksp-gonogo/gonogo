<!--
  GonogoKosUplink: the kOS bridge extension for gonogo/Sitrep (mod/GonogoKosUplink).

  This assembly compile-time links kOS (GPLv3, cloned for reference at
  local_docs/reference/kos/) and, from P1 onward, 0Harmony for one
  observe-only patch. Per local_docs/telemetry-mod/kos-migration-spec.md
  §8 the link is deliberate, no arm's-length reflection, no loopback
  telnet.

  gonogo overall is MIT (see LICENSING.md). GonogoKosUplink is THE exception:
  linking GPLv3 kOS makes this assembly GPL-3.0-only. It is a dependency
  leaf (nothing references it) so that obligation propagates nowhere, and
  the MIT Sitrep.* assemblies it links are GPL-compatible in that direction.

  This program is free software: you can redistribute it and/or modify it
  under the terms of the GNU General Public License v3.0 as published by
  the Free Software Foundation. The full text is in this directory's LICENSE
  and at the repository root as LICENSE-GPL-3.0.txt.

  Packaging: GonogoKosUplink is a SEPARATE, optional deployable extension (its
  own GameData/GonogoKosUplink folder + its own CKAN/SpaceDock listing via
  GonogoKosUplink.netkan, GPLv3-linkage documented in NOTICE-KOS.txt): build +
  deploy with `build gonogokosuplink` (build_gonogokosuplink in
  scripts/gonogo_claude_tools.sh). It must not bundle
  core Gonogo's or kOS's or Harmony's assemblies; every Reference/
  ProjectReference below that isn't unique to this extension is
  Private="false" for exactly that reason (see each ItemGroup's comment).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- net48, not net472: the live kOS.dll / kOS.Safe.dll we link
         (local_docs/syncthing/kspdata/GameData/kOS/Plugins/) are built
         against .NETFramework 4.8 (MSB3274/3275 otherwise): KSP's Mono
         runtime loads either target fine. Mirrors GonogoScansatUplink. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoKosUplink</AssemblyName>
    <RootNamespace>Gonogo.KosUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- KspManaged / KspGameData: roots for the portable reference DLLs below.
       Default to the repo's local dev copies so a plain `dotnet build` with
       no /p: overrides keeps working unchanged; CI passes /p:KspManaged=...
       /p:KspGameData=... pointing at a checked-out ksp-managed reference-
       assembly repo instead (see kerbcam's Plugin.csproj for the precedent
       this mirrors). -->
  <PropertyGroup>
    <KspGameData Condition="'$(KspGameData)' == ''">$(MSBuildThisFileDirectory)..\..\local_docs\syncthing\kspdata\GameData</KspGameData>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: same portable copy + HintPath
       pattern as Gonogo.KSP.csproj / GonogoTelemetry.csproj. Private=false:
       never copied to output; KSP's own KSP_Data/Managed satisfies the
       load at runtime. -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- kOS: the GPLv3 link that makes this assembly GPL (see the header
       comment above). Loaded from the live KSP install's own kOS mod
       folder; Private=false: kOS ships and updates itself, GonogoKosUplink
       must never bundle a stale copy of it. -->
  <ItemGroup>
    <Reference Include="kOS" Private="false">
      <HintPath>$(KspGameData)\kOS\Plugins\kOS.dll</HintPath>
    </Reference>
    <Reference Include="kOS.Safe" Private="false">
      <HintPath>$(KspGameData)\kOS\Plugins\kOS.Safe.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Harmony: P1 uses it for the ONE observe-only postfix on
       ScreenBuffer.Print (spec §4(b)/§6, KosComputeHarmony.cs), the compute
       feed's at-source capture. Installed only when the version-guard
       confirms the target exists; otherwise compute falls back to the
       snapshot-scrape (spec §4.4). Loaded from 000_Harmony's own
       mod folder; Private=false: every other Harmony-dependent mod in
       this install already provides it, GonogoKosUplink must not bundle a
       second copy. -->
  <ItemGroup>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(KspGameData)\000_Harmony\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Sitrep.Contract, and nothing else of core Gonogo's: compile-time only.
    ISitrepUplink, IUplinkHost and UplinkManifest all live in Sitrep.Contract
    (UplinkContract.cs), so an Uplink needs no more than this to be built by
    anyone. That is the whole point of the isolation rule: Sitrep.Host,
    Sitrep.Core and Sitrep.Transport are unpublished, and a third-party author
    can neither install nor build against them.

    Sitrep.Host / Sitrep.Core / Sitrep.Transport used to be listed here, from
    when the uplink contract lived in Sitrep.Host. It moved to Sitrep.Contract
    and the references outlived the reason for them: by the time they were
    removed not one line of this project imported a type from any of the three.

    Private=false: core Gonogo already ships Sitrep.Contract.dll in
    GameData/Gonogo/Plugins and KSP loads every GameData plugin into one
    AppDomain, so this Uplink resolves those types from core's copy at runtime
    and must not bundle a second one.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj" Private="false" />
  </ItemGroup>

  <!-- GonogoKosUplink.Contract: THIS Uplink's own eleven wire types, relocated
       out of Sitrep.Contract (see that project's header comment). Deliberately
       WITHOUT Private="false", unlike Sitrep.Contract above: that one is core
       Gonogo's assembly, already in GameData/Gonogo/Plugins, and a bundled
       copy here would shadow it. This one is ours and nothing else
       ships it, so it must be copied into this extension's own deploy set,
       making GonogoKosUplink a TWO-DLL deployable (see build_gonogokosuplink in
       scripts/gonogo_claude_tools.sh). -->
  <ItemGroup>
    <ProjectReference Include="..\GonogoKosUplink.Contract\GonogoKosUplink.Contract.csproj" />
  </ItemGroup>

</Project>
