<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sitrep.Core/Sitrep.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../golden-fixtures/version.json" Link="golden-fixtures/version.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/clock.json" Link="golden-fixtures/clock.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/stub-network.json" Link="golden-fixtures/stub-network.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/archive.json" Link="golden-fixtures/archive.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/courier.json" Link="golden-fixtures/courier.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/kernel.json" Link="golden-fixtures/kernel.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/serialization.json" Link="golden-fixtures/serialization.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Sitrep.Contract/unit-coverage.baseline.json" Link="golden-fixtures/unit-coverage.baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Sitrep.Contract's netstandard2.0 build compiles RtConfig, which
       references Reinforced.Typings. `Assembly.GetTypes()` over that build
       (UnitDescriptorTests) resolves every type including that one, so the
       DLL has to be beside the test assembly. It is a CODEGEN dependency and
       goes no further than this test project: the deployed mod loads the
       net472 build, where every RT usage is compiled out. -->
  <ItemGroup>
    <PackageReference Include="Reinforced.Typings" Version="1.6.7" PrivateAssets="all" />
  </ItemGroup>
</Project>
