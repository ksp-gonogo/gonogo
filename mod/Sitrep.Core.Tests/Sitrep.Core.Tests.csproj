<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sitrep.Core/Sitrep.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../golden-fixtures/version.json" Link="golden-fixtures/version.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/clock.json" Link="golden-fixtures/clock.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/stub-network.json" Link="golden-fixtures/stub-network.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/archive.json" Link="golden-fixtures/archive.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/courier.json" Link="golden-fixtures/courier.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/kernel.json" Link="golden-fixtures/kernel.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden-fixtures/serialization.json" Link="golden-fixtures/serialization.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Sitrep.Contract/unit-coverage.baseline.json" Link="golden-fixtures/unit-coverage.baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- NO Reinforced.Typings reference. There was one, because the shipped
       contract used to compile RtConfig and the RT attributes, so
       Assembly.GetTypes() over it (UnitDescriptorTests) had to resolve an
       assembly that is deliberately never deployed.

       Putting the DLL beside the test binary answered that, and in doing so
       made ContractEnumRenderingTests unable to see the very defect it exists
       to catch: with the leak present and a copy in bin it passes 5 of 6,
       without the copy it fails 6 of 6. The attributes now live only in the
       *.Contract.Codegen twins. Do not add it back. -->
</Project>
