<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). RealFuels is CC-BY-SA, a
       ShareAlike CONTENT licence whose obligations could reach a COMBINED work.
       This uplink therefore NEVER links RealFuels.dll and NEVER derives from its
       types, it reaches every RealFuels member by runtime reflection
       (RealFuelsReflection), the same arm's-length pattern gonogo uses for every
       third-party-mod uplink. That boundary is what keeps this assembly clear of
       the ShareAlike obligation. RealFuels' attribution notice is retained in
       NOTICE-RealFuels.txt alongside this file. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoRealFuelsUplink</AssemblyName>
    <RootNamespace>GonogoRealFuelsUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: Private="false" (reference-only, never
       copied to the output). Vessel/Part/PartModule/FlightIntegrator live in
       Assembly-CSharp. RealFuels is NOT referenced, by design (reflection
       instead). -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract ONLY (Private="false"): the arm's-length compile surface a
       third-party uplink needs, provided by the core mod at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- GonogoRealFuelsUplink.Contract: this Uplink's OWN wire types. Private
       defaults to true (unlike the Sitrep.Contract reference above): core does
       not provide this DLL at runtime, so it bundles into this Uplink's own
       GameData output. -->
  <ItemGroup>
    <ProjectReference Include="..\GonogoRealFuelsUplink.Contract\GonogoRealFuelsUplink.Contract.csproj" />
  </ItemGroup>

</Project>
