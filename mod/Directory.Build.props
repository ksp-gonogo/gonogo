<Project>

  <!--
    Where the KSP / Unity reference assemblies live, defined ONCE for every
    project under mod/ rather than repeated in ten csproj files.

    The DLLs are KSP's and are not redistributable, so they are never committed:
    each machine points at its own copy, and CI passes -p:KspManaged= explicitly
    from the private ksp-gonogo/ksp-managed checkout. A command-line property is
    global and wins over everything here, which is why every assignment below is
    conditioned on the property being empty.

    The directory is local_docs/ksp-references. local_docs is gitignored, so
    a machine whose copy still sits under an older directory name points this
    at it with a symlink rather than a private edit to this file.
  -->
  <PropertyGroup Condition="'$(KspManaged)' == ''">
    <_KspReferences>$(MSBuildThisFileDirectory)..\local_docs\ksp-references</_KspReferences>
    <!--
      A git worktree has no local_docs of its own (it is gitignored), so the path
      above resolves into nothing there and a C# build in a worktree cannot find
      the assemblies the main checkout plainly holds. GONOGO_DATA_ROOT names the
      checkout that has them; `scripts/gonogo_claude_tools.sh` reads the same
      variable, and `fleet-ephemeral.sh` exports it into every agent session.

      NOT a symlink into the worktree. That was tried and reverted: it puts a
      link to the syncthing mirror and the design notes inside a directory that
      gets pruned, which is how that folder was lost once already.
    -->
    <_KspReferences Condition="!Exists('$(_KspReferences)') And '$(GONOGO_DATA_ROOT)' != ''">$(GONOGO_DATA_ROOT)\local_docs\ksp-references</_KspReferences>
    <!-- Named even when absent (a worktree, a fresh clone, CI without the
         checkout), so the "could not resolve Assembly-CSharp" message points
         at where the DLLs SHOULD go. -->
    <KspManaged>$(_KspReferences)</KspManaged>
  </PropertyGroup>

</Project>
