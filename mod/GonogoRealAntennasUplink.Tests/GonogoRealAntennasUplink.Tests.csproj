<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Compile only the PURE, KSP-free files from the uplink so the tests never
       need the KSP/reflection-dependent assembly (same selective-Compile pattern
       GonogoScansatUplink.Tests uses). RaLinkBudget is the re-derived RA
       link-budget math (comms-uplink-design.md §4.3); RaLinkDown is the
       link-DOWN payload builders; RaWire is the publish-boundary flatten that
       replaced core's hand-written serializer cases when these three types left
       Sitrep.Contract (all three KSP-free). -->
  <ItemGroup>
    <Compile Include="..\GonogoRealAntennasUplink\RaLinkBudget.cs" />
    <Compile Include="..\GonogoRealAntennasUplink\RaLinkDown.cs" />
    <Compile Include="..\GonogoRealAntennasUplink\RaWire.cs" />
    <!-- RaLinkDirection is the pure, KSP-free up/down resolver for the RA link's
         forward/reverse rates; RaLinkDirectionTests exercises both orientations. -->
    <Compile Include="..\GonogoRealAntennasUplink\RaLinkDirection.cs" />
    <!-- RaReach is RA's answer to the comms seam's reach question. Its live half
         needs RaReflection and so a running RA, but the branch worth pinning
         headlessly is the fail-soft one: an unreadable surface must degrade to
         ABSENT and not to "nothing reaches", because the second darkens every
         contact prediction on the strength of a failed read. RaReflection comes
         with it and is itself KSP-free (it reaches RA only by reflection). -->
    <Compile Include="..\GonogoRealAntennasUplink\RaReach.cs" />
    <Compile Include="..\GonogoRealAntennasUplink\RaReflection.cs" />
  </ItemGroup>

  <!-- RaRouting.cs is the RA route between two nodes, carved out of
       RaCommsBackend so a headless test can enter it: the backend itself needs
       RaReflection and a live vessel, while the route names only CommNet's
       CommNode / CommNetwork / CommPath / CommLink, which are plain classes
       with no scene dependency (the same reference-DLL contract
       Gonogo.KSP.Tests already relies on for FleetCommsReader). Soft-degrades
       when the reference set is absent, like every other KspManaged suite. -->
  <PropertyGroup>
    <AssemblyCSharpDll>$(KspManaged)\Assembly-CSharp.dll</AssemblyCSharpDll>
    <KspManagedAvailable Condition="Exists('$(AssemblyCSharpDll)')">true</KspManagedAvailable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Routing\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(KspManagedAvailable)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AssemblyCSharpDll)</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Compile Include="..\GonogoRealAntennasUplink\RaRouting.cs" />
    <Compile Include="Routing\**\*.cs" />
  </ItemGroup>

  <Target Name="WarnIfKspManagedMissing" BeforeTargets="Build" Condition="'$(KspManagedAvailable)' != 'true'">
    <Warning Text="Assembly-CSharp.dll not found under KspManaged=$(KspManaged): RaRoutingTests SKIPPED (soft-degrade), so nothing is checking that this Uplink routes through RealAntennas' own FindClosestWhere rather than stock's FindPath. Pass /p:KspManaged=&lt;dir containing Assembly-CSharp.dll&gt; to compile and run them." />
  </Target>

  <!-- The C#-to-TS golden fixture for the CommsHop provider-extension bag:
       CommsHopExtensionWireTests proves this file is exactly what the real codec
       produces, and the client's hopExt.test.ts reads it back through the real
       decode path, so neither side can drift silently. -->
  <ItemGroup>
    <None Include="..\golden-fixtures\commshop-extensions.json" Link="golden-fixtures/commshop-extensions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- PayloadMeta/Quality/Units and the [Sitrep*] attributes (KSP-free). -->
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj" />
    <!-- GonogoRealAntennasUplink.Contract: this Uplink's own three wire payload
         types, relocated out of Sitrep.Contract/Comms.cs (see that project's
         header comment). RaLinkDown builds them and RealAntennasUnitCoverageTests
         reflects over the assembly directly. -->
    <ProjectReference Include="..\GonogoRealAntennasUplink.Contract\GonogoRealAntennasUplink.Contract.csproj" />
    <!-- Sitrep.Contract.TestSupport: the shared Unit-coverage sweep every
         relocated Uplink's <X>UnitCoverageTests calls (see
         UnitCoverageAssertion's own doc comment). The [Fact]s stay here, naming
         this Uplink's own types. -->
    <ProjectReference Include="..\Sitrep.Contract.TestSupport\Sitrep.Contract.TestSupport.csproj" />
    <!-- Sitrep.Core: the real JsonWriter, so the wire-shape tests that used to
         live in Sitrep.Core.Tests/CommsWireTests.cs can follow their payloads
         here and keep asserting through the production serializer rather than a
         hand-rolled stand-in. -->
    <ProjectReference Include="..\Sitrep.Core\Sitrep.Core.csproj" />
  </ItemGroup>

</Project>
