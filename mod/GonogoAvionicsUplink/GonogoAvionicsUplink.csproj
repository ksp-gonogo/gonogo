<Project Sdk="Microsoft.NET.Sdk">

  <!-- MIT, like the rest of gonogo (see LICENSING.md). RP-1 (the RP-0 plugin,
       RP0.dll) is CC-BY-NC-SA-4.0, a Non-Commercial ShareAlike CONTENT licence
       whose obligations could reach a COMBINED work. This uplink therefore NEVER
       links RP-0's assembly and NEVER derives from its types, it reaches every
       RP-1 avionics member by runtime reflection (AvionicsReflection), the same
       arm's-length pattern gonogo uses for every third-party-mod uplink. That
       boundary is what
       keeps this assembly clear of the NC/ShareAlike obligations. RP-1's
       attribution notice is retained in NOTICE-RP1.txt alongside this file. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GonogoAvionicsUplink</AssemblyName>
    <RootNamespace>GonogoAvionicsUplink</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- KspManaged: root for the portable KSP/Unity reference DLLs (below).
       Defaults to the repo's local dev copy so a plain `dotnet build` with no
       /p: overrides keeps working; CI passes /p:KspManaged=... instead. -->
  <PropertyGroup>
    <KspManaged Condition="'$(KspManaged)' == ''">$(MSBuildThisFileDirectory)..\..\local_docs\telemachus-fork\references</KspManaged>
  </PropertyGroup>

  <!-- KSP / Unity reference assemblies: Private="false" (reference-only, never
       copied to the output). Vessel/Part/PartModule live in Assembly-CSharp. The
       RP-0 plugin is NOT referenced, by design (reflection instead). -->
  <ItemGroup>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Private="false">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Sitrep.Contract ONLY (Private="false"): the arm's-length compile surface
       a third-party uplink needs. NO reference to RP0.dll, by design. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
