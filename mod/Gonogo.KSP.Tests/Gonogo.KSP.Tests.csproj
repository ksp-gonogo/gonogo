<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Sitrep.Host is KSP-free (netstandard2.0;net472, zero KSP/Unity
       reference), so KscLightTimeMath.cs's dependency on its
       SignalDelayConfig POCO needs no KspManaged gating at all - unlike
       PendingCreditLedger.cs's ConfigNode dependency below, this compiles
       and runs unconditionally, on every checkout. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Host\Sitrep.Host.csproj" />
  </ItemGroup>

  <!-- VesselScienceAggregator.cs is pure arithmetic + bookkeeping with no
       KSP/Unity types at all, so it needs no KspManaged gating either -
       same reasoning as KscLightTimeMath.cs above. -->
  <ItemGroup>
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\KscDelay.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\KscDelayPolicy.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\KscLightTimeMath.cs" />
    <!-- LiveOriginDelay.cs is the roster WALK an away currency event uses to find
         the vessel it came from. The roster and the route read are both live-scene
         reads and stay in KscLightTime.cs under the gate below; the walk is generic
         over the vessel type precisely so it carries no KSP dependency and is
         exercised on every checkout. It was the missing step behind a craft with a
         working link home being held for the silence deadline. -->
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\LiveOriginDelay.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\VesselScienceAggregator.cs" />
    <!-- RoutedPathDelay.cs is the light-time arithmetic behind every routed
         comms read, deliberately written against measured distances rather
         than CommNet types (see its own doc comment) so it needs no
         KspManaged gating either. The CommNet-walking half that feeds it,
         FleetCommsReader.cs, is gated below. -->
    <Compile Include="..\Gonogo.KSP\RoutedPathDelay.cs" />
    <!-- CommNetOcclusion.cs is stock's occlusion RULE, deliberately carved out
         of CommNetBackend.cs so it carries no KSP dependency (the live read of
         the two multipliers stays in the backend). CommNetBackend.cs, compiled
         under the KspManaged gate below, calls into it, so it has to be here
         unconditionally rather than beside it. -->
    <Compile Include="..\Gonogo.KSP\CommNetOcclusion.cs" />
    <!-- The maneuver WRITE-path ownership RULE, carved out of KspVesselActuator
         so it carries no KSP dependency - same discipline as CommNetOcclusion
         above, and for a sharper reason: the actuator's command bodies reference
         Unity assemblies the reference set does not ship, so a headless test
         cannot enter them at all. -->
    <Compile Include="..\Gonogo.KSP\PlanOwner.cs" />
    <!-- The code+sentence pair every carved-out refusal rule returns. -->
    <Compile Include="..\Gonogo.KSP\Refusal.cs" />
    <!-- Which FACILITY authorises a maneuver write, carved out beside it and for
         the same reason. Sitrep.Contract only, no KSP type. -->
    <Compile Include="..\Gonogo.KSP\ManeuverWriteAuthority.cs" />
    <!-- What a command answers when the craft gonogo reports is not the one KSP
         is flying. The write-side half of the active-vessel seam, which the seam
         itself cannot cover: the stock calls underneath take no vessel and
         resolve KSP's own active one themselves. Named by ManeuverWriteAuthority
         above and by four command bodies that are not compiled here at all, so
         it has to be here. Sitrep.Contract only, no KSP type. -->
    <Compile Include="..\Gonogo.KSP\EvaCommandRule.cs" />
    <!-- Whether KSP will propagate control input to this craft at all. The same
         carve-out as the rule above and for the same reason, but a different
         question: that one asks which craft we are reporting, this one asks
         whether the craft can take a stick. Named by three command bodies that
         are not compiled here. Sitrep.Contract only, no KSP type. -->
    <Compile Include="..\Gonogo.KSP\ControlInputAuthority.cs" />
    <!-- The three refusals ModuleScienceExperiment.DeployExperiment makes, and
         the order it makes them in. The module is a PartModule and needs a live
         part; the rule takes the three facts and needs nothing. -->
    <Compile Include="..\Gonogo.KSP\ExperimentDeployRule.cs" />
    <!-- What TimeWarp actually settled on against what the command asked for.
         The read is live; the comparison is not. -->
    <Compile Include="..\Gonogo.KSP\WarpRateOutcome.cs" />
    <!-- What stock's own space bar checks before it stages. -->
    <Compile Include="..\Gonogo.KSP\StageRule.cs" />
    <Compile Include="..\Gonogo.KSP\StrategyEligibility.cs" />
    <!-- CommandCentreReach.cs is the "can CommNet route here at all" rule the
         crewed-vessel enumeration gates on. It names no KSP type on purpose (the
         two node powers arrive as doubles, the part walk is generic over the part),
         so it compiles and is checked on every checkout, while its only caller,
         CrewedVesselSource.cs, needs a live Vessel and is not compiled here at all
         - same carve-out as CommNetOcclusion.cs above. -->
    <Compile Include="..\Gonogo.KSP\CommandCentres\CommandCentreReach.cs" />
    <!-- CalendarEpoch.cs reflects the real-world anchor off whatever date
         formatter the game installed. It takes a plain object and names no KSP
         type, so the shapes it has to survive (an anchor named epoch, an
         anchor named something else, two anchors, none) are all stand-ins a
         headless test can declare. -->
    <Compile Include="..\Gonogo.KSP\CalendarEpoch.cs" />
    <!-- EvaParentage.cs is the RULE behind ActiveVesselScope: which vessel gonogo
         reports as active while a kerbal is outside their craft. It takes ids and
         a liveness probe and names no KSP type, so it is exercised on every
         checkout. ActiveVesselScope.cs itself reads FlightGlobals and subscribes
         to GameEvents and is NOT here, the same carve-out as CommNetOcclusion.cs
         and PlanOwner.cs above. -->
    <Compile Include="..\Gonogo.KSP\EvaParentage.cs" />
  </ItemGroup>

  <!-- PendingCreditRow.cs was split out of PendingCreditLedger.cs specifically so this row/enum
       pair - and everything built on it below - carries no ConfigNode dependency and needs no
       KspManaged gating. CurrencyDelayGuard.cs (the shared re-entrancy guard between
       StockCurrencyInterceptor and RevealApplier), RevealDecision.cs (the pure reveal-ordering
       core behind RevealApplier), and ScienceChunkCredit.cs (the pure aggregator-chunk -> ledger
       row conversion shared by RevealApplier's aggregator drain and the DelayedScienceSink
       per-increment path) are the same discipline. RevealApplier.cs and DelayedScienceSink.cs
       themselves are NOT included here (real KSP/Unity types), same treatment as
       StockCurrencyInterceptor.cs above. -->
  <ItemGroup>
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\PendingCreditRow.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\CurrencyDelayGuard.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\RevealDecision.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\ScienceChunkCredit.cs" />
    <!-- DerivedCurrencyWithholding.cs is the core's fan-out to the arms that keep a
         quantity some other mod DERIVES from a delayed currency change withheld for
         as long as the change is. It names Sitrep.Contract's Kernel and nothing of
         KSP's, so it gets the same unconditional treatment - and it needs it: the
         confidence leak was never a wrong piece, it was no piece at all, so the
         fan-out and the wiring that reaches it are the two halves worth checking. -->
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\DerivedCurrencyWithholding.cs" />
  </ItemGroup>

  <!-- The Deck-only currency probe's three READINGS, carved out of the
       GonogoDevCurrency addon (a MonoBehaviour polling live balances and the
       live CommNet graph, not one line of which runs headlessly) for the same
       reason CommNetOcclusion.cs and PlanOwner.cs above were carved out of
       their own callers. This is the half a reader of the result file actually
       reasons from, and the half that is quietly wrong when the file says
       nothing useful. No KSP/Unity type, so no KspManaged gating. -->
  <ItemGroup>
    <Compile Include="..\GonogoDevTools\CurrencyProbeVerdicts.cs" />
    <Compile Include="..\GonogoDevTools\AntennaProbeVerdicts.cs" />
  </ItemGroup>

  <!-- StockCurrencyDecision.cs mirrors TransactionReasons as its own plain
       enum specifically so it carries no KSP/Unity dependency either - same
       reasoning again. StockCurrencyStateMachine.cs (the shadow-tracking,
       deferred-science, and recovery/lab vessel correlation core behind
       StockCurrencyInterceptor) has the same discipline and is included
       here too. StockCurrencyInterceptor.cs, the GameEvents glue that
       calls into both, is NOT included here (it needs the real Vessel/
       ProtoVessel/TransactionReasons/CurrencyModifierQuery types), same
       treatment as KscLightTime.cs above it. -->
  <ItemGroup>
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\StockCurrencyDecision.cs" />
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\StockCurrencyStateMachine.cs" />
    <!-- CurrencyQueryBases.cs is the third piece of that same carve-out, and the
         one the interleaving defect lived in: it remembers what a currency
         change was asked for, off a modifier query the interceptor hands it as
         three plain numbers and a mirrored reason. No KSP type is involved, so
         the RP-1 interleaving that used to erase a science base is reproducible
         here rather than only on the rig. -->
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\CurrencyQueryBases.cs" />
  </ItemGroup>

  <!-- PendingCreditLedger.cs is pure logic, but its OnSave/OnLoad round-trip
       touches the real KSP ConfigNode type (from Assembly-CSharp), per
       Gonogo.KSP's own rule that it is the only assembly in the mod allowed
       to reference KSP/Unity types. ConfigNode is a plain data structure with
       no scene/runtime dependency, so it's genuinely loadable and testable in
       a headless process - the same reasoning GonogoKosUplink.Tests already
       applies to kOS.Safe.dll. This project therefore compiles the ledger
       source directly (not a ProjectReference on Gonogo.KSP, which pulls in
       many files that DO need a live scene) and soft-degrades exactly like
       that project: when the reference DLL isn't present (a fresh checkout
       with no synced KSP install / local_docs), this suite is dropped with a
       build warning instead of failing the build. -->
  <PropertyGroup>
    <AssemblyCSharpDll>$(KspManaged)\Assembly-CSharp.dll</AssemblyCSharpDll>
    <KspManagedAvailable Condition="Exists('$(AssemblyCSharpDll)')">true</KspManagedAvailable>
    <!-- The robotics suite constructs real Expansions.Serenity servo modules,
         and BaseServo declares ConfigurableJoint/Rigidbody FIELDS, so the CLR
         resolves UnityEngine.PhysicsModule the moment one of those types
         loads - before any constructor runs, and regardless of the fact that
         nothing here touches physics and no servo ever joins a scene. It is
         the one DLL beyond the four-file reference set those tests need; a
         Managed/ directory copied out of a real install has it, the trimmed
         local_docs reference sets may not. -->
    <PhysicsModuleDll>$(KspManaged)\UnityEngine.PhysicsModule.dll</PhysicsModuleDll>
    <ServoModulesAvailable Condition="'$(KspManagedAvailable)' == 'true' And Exists('$(PhysicsModuleDll)')">true</ServoModulesAvailable>
  </PropertyGroup>

  <!-- The SDK auto-globs CurrencyDelay/**, SilenceTracking/**, Comms/**,
       CommandCentres/** and Career/**; drop them all unless Assembly-CSharp.dll
       is present, then re-add them (and the KSP-touching sources) below. -->
  <ItemGroup>
    <Compile Remove="CurrencyDelay\**\*.cs" />
    <Compile Remove="SilenceTracking\**\*.cs" />
    <Compile Remove="Comms\**\*.cs" />
    <Compile Remove="CommandCentres\**\*.cs" />
    <Compile Remove="Career\**\*.cs" />
    <Compile Remove="Robotics\**\*.cs" />
    <!-- KspEnumMirrorTests.cs sits at the project root rather than in a folder,
         so the blanket folder Removes above do not reach it and it needs its own.
         It compares Sitrep.Contract's KSP-enum mirrors against the real enums in
         Assembly-CSharp, so it is gated like every other KspManaged suite here. -->
    <Compile Remove="KspEnumMirrorTests.cs" />
    <!-- ActiveVessel/ is otherwise unconditional (EvaParentageTests names no KSP
         type at all), so only its ConfigNode half needs dropping here; it is
         re-added under the gate below beside the other round-trip suites. -->
    <Compile Remove="ActiveVessel\EvaParentagePersistenceTests.cs" />
  </ItemGroup>

  <!-- KscLightTimeTests.cs, VesselScienceAggregatorTests.cs, and
       StockCurrencyStateMachineTests.cs only exercise zero-KSP-dependency
       sources (see their own doc comments), so they are re-added here,
       unconditionally, right after the blanket Remove above - unlike
       PendingCreditLedgerTests.cs below, they never need KspManaged. -->
  <ItemGroup>
    <Compile Include="CurrencyDelay\KscLightTimeTests.cs" />
    <Compile Include="CurrencyDelay\VesselScienceAggregatorTests.cs" />
    <Compile Include="CurrencyDelay\StockCurrencyDecisionTests.cs" />
    <Compile Include="CurrencyDelay\StockCurrencyStateMachineTests.cs" />
    <Compile Include="CurrencyDelay\CurrencyDelayGuardTests.cs" />
    <Compile Include="CurrencyDelay\RevealDecisionTests.cs" />
    <Compile Include="CurrencyDelay\ScienceChunkCreditTests.cs" />
    <!-- Reads the shipped source of the two KSP-only files below rather than
         loading them, so it needs KspManaged no more than the rest of this
         group does - and it is precisely the files this project cannot compile
         that it exists to check. -->
    <Compile Include="CurrencyDelay\CurrencyDelaySettlePumpIsWiredTests.cs" />
    <Compile Include="CurrencyDelay\AwayScienceArmIsWiredTests.cs" />
    <Compile Include="CurrencyDelay\AwayScienceOriginIsResolvedTests.cs" />
    <!-- The shipped-source reader all three of those share. It was copied into
         each of them first, which is three brace matchers to keep in step and
         the fiddliest code here to get wrong. -->
    <Compile Include="CurrencyDelay\CurrencyDelaySourceText.cs" />
    <Compile Include="CurrencyDelay\CurrencyQueryBasesTests.cs" />
    <Compile Include="CurrencyDelay\LiveOriginDelayTests.cs" />
    <Compile Include="CurrencyDelay\DerivedCurrencyWithholdingTests.cs" />
    <Compile Include="CurrencyDelay\DerivedCurrencyArmIsWiredTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(KspManagedAvailable)' == 'true'">
    <!-- ConfigNode's own overload sets (AddValue/TryGetValue for Vector3,
         Quaternion, Color, ...) reference UnityEngine.CoreModule types even
         though this file only calls the double/string overloads, so the
         compiler needs it resolvable too. Private (CopyLocal) stays default
         true here, unlike Gonogo.KSP.csproj's own Private="false" - that
         project runs inside a live KSP process which already provides these
         DLLs via GameData/../Managed, but this test project runs standalone
         and needs its own copies to actually load at test time. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AssemblyCSharpDll)</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\PendingCreditLedger.cs" />
    <!-- CurrencyDelayLedgerPersistence.cs merges a loaded ledger's rows into an existing
         instance (see CurrencyDelayScenario's OnLoad) - same ConfigNode/PendingCreditLedger-only
         dependency as PendingCreditLedger.cs itself, so it gets the same treatment. -->
    <Compile Include="..\Gonogo.KSP\CurrencyDelay\CurrencyDelayLedgerPersistence.cs" />
    <!-- SilenceTrackerPersistence.cs is the same shape: a ConfigNode round-trip over a
         KSP-free record (Sitrep.Host.Comms.VesselContactState, pulled in transitively via the
         Sitrep.Host ProjectReference above), so it needs the same KspManaged gating. -->
    <Compile Include="..\Gonogo.KSP\SilenceTracking\SilenceTrackerPersistence.cs" />
    <!-- EvaParentagePersistence.cs is the same shape again: a ConfigNode round-trip
         over a KSP-free book (EvaParentage.cs, compiled unconditionally above), so
         it needs the same gating. It is the quickload half of the active-vessel
         seam and the only place the kerbal-to-craft relation reaches the save. -->
    <Compile Include="..\Gonogo.KSP\EvaParentagePersistence.cs" />
    <Compile Include="ActiveVessel\EvaParentagePersistenceTests.cs" />
    <!-- ActiveVesselScope.cs is here to RESOLVE, not to run: CommNetBackend.cs
         below calls it for the vessel whose link it reports, so the type has to
         exist. Its own reads are FlightGlobals fields and GameEvents
         subscriptions, the same live-scene dependency CommNetBackend.cs already
         has under this gate. The half worth exercising is EvaParentage.cs, which
         is compiled unconditionally above. -->
    <Compile Include="..\Gonogo.KSP\ActiveVesselScope.cs" />
    <Compile Include="SilenceTracking\**\*.cs" />
    <!-- FleetCommsReader.cs walks the live CommNet graph, but CommNode /
         CommLink / CommPath / CommNetwork are plain classes with no scene or
         MonoBehaviour dependency (unlike Vessel, which is why only the
         node-to-node half is exercised here), so the reader loads and runs
         headlessly against the reference DLL - same gating contract as the
         ConfigNode-backed suites above. -->
    <Compile Include="..\Gonogo.KSP\FleetCommsReader.cs" />
    <!-- CommandCentreDelayUplink.cs is here for its REGISTRATION, which is
         KSP-free: which of its two sampled sources is subscription-gated is
         the whole of what CommandCentreDelayUplinkRegistrationTests asserts,
         and it is not observable from anywhere else. Its capture half does
         read FlightGlobals, so the type has to resolve, which drags
         KspCommandCentre (CommNode) and CommsCoreUplink (the signal-delay
         config it reads), and CommsCoreUplink in turn drags CommNetBackend +
         DevCommsOverride. All CommNet/CommNode-level types, the same headless
         reference-DLL contract FleetCommsReader.cs above already relies on. -->
    <Compile Include="..\Gonogo.KSP\CommNetBackend.cs" />
    <Compile Include="..\Gonogo.KSP\DevCommsOverride.cs" />
    <Compile Include="..\Gonogo.KSP\CommsCoreUplink.cs" />
    <!-- GonogoConfigFile.cs is CommsCoreUplink's write side for the simulation
         delay policy: ConfigNode plus UnityEngine.Debug, so it sits under this
         gate with its caller. Every failure path inside it is soft, which is
         what lets the policy command run headlessly at all. -->
    <Compile Include="..\Gonogo.KSP\GonogoConfigFile.cs" />
    <!-- FleetSilenceChannels.cs is CommsCoreUplink.Register's direct dependency
         (comms registers the SilenceTracker's reckoning when elected, see that
         call site), so it has to resolve here too. It walks FlightGlobals.Vessels
         live, the same live-scene dependency as CommNetBackend.cs above, so it
         gets the same gating. -->
    <Compile Include="..\Gonogo.KSP\SilenceTracking\FleetSilenceChannels.cs" />
    <Compile Include="..\Gonogo.KSP\SilenceTracking\SilenceGeometrySink.cs" />
    <Compile Include="..\Gonogo.KSP\SilenceTracking\SilenceTrace.cs" />
    <Compile Include="..\Gonogo.KSP\SilenceTracking\SilenceTrackerSink.cs" />
    <Compile Include="..\Gonogo.KSP\FleetVesselSilenceBuilder.cs" />
    <!-- FleetSilenceRosterBuilder.cs builds the fleet.silence aggregate out of
         the same per-vessel builder above, and FleetSilenceChannels.cs calls
         it, so it has to resolve alongside them. Pure dictionary shaping with
         no KSP types of its own; it sits under the gate only because its
         caller does. -->
    <Compile Include="..\Gonogo.KSP\FleetSilenceRosterBuilder.cs" />
    <!-- FleetVesselResourcesBuilder.cs is the same shape: pure dictionary
         shaping with no KSP types, compiled here because FleetChannels.cs (which
         does walk live parts) calls it. -->
    <Compile Include="..\Gonogo.KSP\FleetVesselResourcesBuilder.cs" />
    <Compile Include="..\Gonogo.KSP\CommandCentres\KspCommandCentre.cs" />
    <!-- SurfaceCoordinates.cs turns a centre's world position into the body-fixed
         lat/long the roster publishes. It needs CelestialBody, so it sits under this
         gate with KspCommandCentre, but its longitude wrap is pure arithmetic and is
         the half most easily got wrong, so RosterCoordinateTests exercises it
         directly rather than only through the mapper. -->
    <Compile Include="..\Gonogo.KSP\CommandCentres\SurfaceCoordinates.cs" />
    <Compile Include="..\Gonogo.KSP\CommandCentres\CommandCentreDelayUplink.cs" />
    <Compile Include="CommandCentres\**\*.cs" />
    <Compile Include="Comms\**\*.cs" />
    <!-- The career refusal RULES, carved out of KspCareerActuator so a headless
         test can enter them at all: the actuator's own bodies reach Funding /
         ScenarioUpgradeableFacilities / ContractSystem, every one a MonoBehaviour
         whose Instance is null outside a live scene, so not one line of them
         runs headlessly. Same discipline as PlanOwner.cs and CommNetOcclusion.cs
         above. CareerRefusals.cs takes numbers and needs no KSP types at all;
         it sits under this gate only to keep the career pair together. -->
    <Compile Include="..\Gonogo.KSP\Career\CareerRefusals.cs" />
    <!-- The strategy commitment ORDER, carved out for a sharper reason than the
         rest: Strategy.CanBeActivated dereferences Administration.Instance and
         Strategy.Activate calls CanBeActivated, so neither runs anywhere but the
         Administration screen. The sequence takes an interface instead. -->
    <Compile Include="..\Gonogo.KSP\Career\StrategyCommit.cs" />
    <!-- What a facility's obstructing-vessel walk becomes as a refusal. The walk
         itself is two public SpaceCenterBuilding methods over live scene
         objects; only its answer is decided here. -->
    <Compile Include="..\Gonogo.KSP\Career\FacilityObstruction.cs" />
    <!-- CareerAffordability.cs genuinely needs the reference DLL: it runs
         stock's own CurrencyModifierQuery, a plain class that loads and prices
         a spend headlessly (its RunQuery half fires a GameEvent, whose static
         ctor wants UnityEngine.UI and does not, so a test builds the query
         directly). -->
    <Compile Include="..\Gonogo.KSP\Career\CareerAffordability.cs" />
    <!-- The command-gate declarations and their evaluators, paired at build time
         rather than only by ChannelEngine.ValidateGateDeclarations inside a
         running KSP. GateDeclarations is a table of plain contract objects, and
         the evaluators are only CONSTRUCTED here, never evaluated: their live
         reads (GameVariables, ContractSystem, PreFlightTests) need a scene, and
         .NET resolves a type per method body, so they load without one. The
         Uplinks that consume the table are NOT here: their discovery
         constructors build the real actuators, which do need a scene. -->
    <Compile Include="..\Gonogo.KSP\Gates\CareerGates.cs" />
    <Compile Include="..\Gonogo.KSP\Gates\GateDeclarations.cs" />
    <Compile Include="..\Gonogo.KSP\Gates\KspGateEvaluators.cs" />
    <Compile Include="..\Gonogo.KSP\GameWords.cs" />
    <!-- The launch pre-flight WALK: which of KSP's own launch tests refuses,
         which code that becomes, and what the refusal quotes. The tests
         themselves reach PSystemSetup / Funding / PartLoader and cannot run
         headlessly, but PreFlightTests.IPreFlightTest is an interface, so the
         walk over a faked set is enterable while the bodies are not. -->
    <Compile Include="..\Gonogo.KSP\LaunchPreflight.cs" />
    <Compile Include="Career\**\*.cs" />
    <!-- The KSP-enum mirrors. Nothing of Gonogo.KSP is compiled in for these:
         an enum is a plain value type, so the suite reflects straight over
         Assembly-CSharp's own declarations and compares them to
         Sitrep.Contract's (reached transitively through the Sitrep.Host
         ProjectReference above). -->
    <Compile Include="KspEnumMirrorTests.cs" />
    <!-- The maneuver WRITE-path ownership guard: KspVesselActuator + stock's own
         plan backend, so the refusal can be exercised against a real election.
         Gated because both touch KSP types. -->
    <Compile Include="CurrencyDelay\**\*.cs" Exclude="CurrencyDelay\DerivedCurrencyWithholdingTests.cs;CurrencyDelay\DerivedCurrencyArmIsWiredTests.cs;CurrencyDelay\KscLightTimeTests.cs;CurrencyDelay\VesselScienceAggregatorTests.cs;CurrencyDelay\StockCurrencyDecisionTests.cs;CurrencyDelay\StockCurrencyStateMachineTests.cs;CurrencyDelay\CurrencyDelayGuardTests.cs;CurrencyDelay\RevealDecisionTests.cs;CurrencyDelay\ScienceChunkCreditTests.cs;CurrencyDelay\CurrencyDelaySettlePumpIsWiredTests.cs;CurrencyDelay\AwayScienceArmIsWiredTests.cs;CurrencyDelay\AwayScienceOriginIsResolvedTests.cs;CurrencyDelay\CurrencyDelaySourceText.cs;CurrencyDelay\CurrencyQueryBasesTests.cs;CurrencyDelay\LiveOriginDelayTests.cs" />
  </ItemGroup>

  <!-- ServoCapture.cs is the robotics capture's kind-NAMING rule, carved out of
       KspHost so it carries only Expansions.Serenity's BaseServo and its
       subclasses - same discipline as CommNetOcclusion.cs and PlanOwner.cs
       above, and for the same reason: KspHost's own robotics walk reaches a
       live Vessel and cannot be entered headlessly at all. -->
  <ItemGroup Condition="'$(ServoModulesAvailable)' == 'true'">
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(PhysicsModuleDll)</HintPath>
    </Reference>
    <Compile Include="..\Gonogo.KSP\ServoCapture.cs" />
    <Compile Include="Robotics\**\*.cs" />
  </ItemGroup>

  <Target Name="WarnIfServoModulesMissing" BeforeTargets="Build" Condition="'$(ServoModulesAvailable)' != 'true'">
    <Warning Text="UnityEngine.PhysicsModule.dll not found under KspManaged=$(KspManaged): ServoCaptureTests SKIPPED (soft-degrade), so nothing is checking that every Breaking Ground servo kind reaches the wire. Point KspManaged at a full KSP_Data/Managed directory to run them." />
  </Target>

  <Target Name="WarnIfKspManagedMissing" BeforeTargets="Build" Condition="'$(KspManagedAvailable)' != 'true'">
    <Warning Text="Assembly-CSharp.dll not found under KspManaged=$(KspManaged): PendingCreditLedgerTests and KspEnumMirrorTests SKIPPED (soft-degrade), so nothing is checking that Sitrep.Contract's KSP-enum mirrors still match KSP's own declarations - a member KSP appended would reach the wire as an ordinal no client can name. Pass /p:KspManaged=&lt;dir containing Assembly-CSharp.dll&gt; to compile and run them." />
  </Target>

</Project>
