<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sitrep.Host/Sitrep.Host.csproj" />
  </ItemGroup>
  <!-- The two electable comms backends' OCCLUSION declarations. Each is a
       deliberately KSP-free, reflection-free file carved out of its backend
       (see CommNetOcclusion / RaOcclusion), so the difference between what
       stock CommNet and RealAntennas consider an occluding body can be
       asserted side by side, headlessly, against the REAL declarations rather
       than re-stated constants. Compiling a pure source file out of another
       project is the same pattern Gonogo.KSP.Tests and
       GonogoRealAntennasUplink.Tests already use; a ProjectReference is not an
       option, since both backends' assemblies need a live KSP. This is the
       home for it because CommsElectionTests, next door, owns the election
       these two compete in. -->
  <ItemGroup>
    <Compile Include="../Gonogo.KSP/CommNetOcclusion.cs" />
    <Compile Include="../GonogoRealAntennasUplink/RaOcclusion.cs" />
  </ItemGroup>
  <!-- Reinforced.Typings at RUNTIME, for this test host only.
       Sitrep.Contract deliberately keeps RT out of its runtime closure
       (PrivateAssets="all"), because in KSP anything scanning assemblies
       would try to resolve Reinforced.Typings.dll, which is never deployed.
       That is still right and this does not change it.
       These tests are the one consumer that loads the netstandard2.0 build
       on a full runtime, and that build DOES carry the [TsEnum]/[TsInterface]
       attributes (they are compiled under #if NETSTANDARD2_0; the net472
       build KSP loads has none). Resolving a custom attribute is not
       optional there: Enum.TryParse<TargetKind> walks the enum's attributes
       to find FlagsAttribute, so it threw FileNotFoundException on a type
       nothing in the test even mentions. A test project is never deployed to
       GameData, so satisfying it here cannot leak into the game. -->
  <ItemGroup>
    <PackageReference Include="Reinforced.Typings" Version="1.6.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- The CI "lying minor" contract-shape gate's baseline; see
         ContractShapeGateTests's doc comment. Wired in the same
         golden-fixtures/ pattern Sitrep.Core.Tests already uses. -->
    <None Include="../Sitrep.Contract/contract-shape.baseline.json" Link="golden-fixtures/contract-shape.baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
