<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GonogoMechJebUplink's OWN contract slice: the wire payload types
    (MechJebAscentArgs/MechJebNoArgs) that used to live in Sitrep.Contract,
    relocated here per the operator mandate that NO uplink-specific wire type
    may live in core, even for an in-monorepo Uplink (see
    local_docs/design/2026-08-10-uplink-types-out-of-core-plan.md). This is
    the pilot for the per-uplink codegen mechanism every other Uplink's
    relocation copies.

    Deliberately its OWN small project rather than a second TFM leg bolted
    onto GonogoMechJebUplink.csproj: these two DTOs have no MechJeb2/UnityEngine
    dependency at all, so splitting them out means the netstandard2.0 codegen
    leg never has to see (or conditionally exclude) the MechJeb2.dll/
    UnityEngine.dll HintPath references GonogoMechJebUplink.csproj carries.
    That keeps this project's dual-target boilerplate a straight copy of
    Sitrep.Contract.csproj's (see below), instead of a per-TFM Compile
    Remove/Reference Condition maze. The next Uplink to migrate (Avionics,
    Kerbcast, ...) should default to this same split-project shape unless its
    wire types are so entangled with its own SDK-touching code that splitting
    is genuinely impractical.

    MIT, not GPL-3.0-only: unlike GonogoMechJebUplink.csproj (which links
    MechJeb2, GPLv3), this slice declares only plain DTOs against
    Sitrep.Contract, no MechJeb2 code. Mirrors Sitrep.Contract's own
    reasoning (it is "the public Uplink surface"): a third party could write
    an alternative MechJeb-ascent client against this exact wire shape
    without pulling in GPL code. GonogoMechJebUplink.csproj bundles this
    DLL into its own GameData output (ordinary ProjectReference, Private
    defaults to true), which is fine, MIT is GPL-compatible in that
    direction.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>GonogoMechJebUplink.Contract</AssemblyName>
    <RootNamespace>Gonogo.MechJebUplink</RootNamespace>
  </PropertyGroup>

  <!-- Reinforced.Typings is a compile-time-only codegen dependency: rtcli
       reads the [TsInterface] attributes baked into this assembly's metadata
       to generate this Uplink's own TS SDK slice (see codegen.sh). Must NOT
       flow to net48 (the runtime TFM GonogoMechJebUplink.csproj bundles):
       same PrivateAssets/Condition/#if NETSTANDARD2_0 discipline as
       Sitrep.Contract.csproj, for the identical reason (a Kopernicus-loaded
       net48 assembly must never try to resolve Reinforced.Typings.dll). -->
  <ItemGroup>
  </ItemGroup>

  <!-- Sitrep.Contract only, Private="false": SitrepContractAttribute/
       SitrepUnitAttribute/Units are core's cross-package surface, provided
       by the core mod (GonogoCore) at runtime, never copied here. Same
       pattern GonogoMechJebUplink.csproj already uses for its own
       Sitrep.Contract reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Sitrep.Contract\Sitrep.Contract.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
